# OS
Thumbs.db
Desktop.ini
.DS_Store

# Environment and secrets (never commit)
.env
.env.*
!.env.example

# Logs and temp
*.log
*.tmp
*.temp
~$*
.cache/

# Dependencies and build output
node_modules/
dist/
build/
out/
target/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Package manager / lock noise (uncomment if you prefer not to track)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# IDE and local tools
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/
*.code-workspace

# Coverage and test artifacts
coverage/
.nyc_output/
htmlcov/

# Runtime generated state snapshots
mars-runtime/state/runs/
projects/seo-content-agent/raw/
projects/metabot-seo-content-agent/raw/

# Local frontend workspaces (see workspaces/README.md)
workspaces/*
!workspaces/README.md
!workspaces/triumph-manipulator-landing/
# Triumph Manipulator Landing — explicit allow-list (everything else under this dir stays ignored)
workspaces/triumph-manipulator-landing/*
!workspaces/triumph-manipulator-landing/README.md
!workspaces/triumph-manipulator-landing/.gitkeep
!workspaces/triumph-manipulator-landing/.gitignore
!workspaces/triumph-manipulator-landing/package.json
!workspaces/triumph-manipulator-landing/package-lock.json
!workspaces/triumph-manipulator-landing/gulpfile.js
!workspaces/triumph-manipulator-landing/src/
!workspaces/triumph-manipulator-landing/src/**
!workspaces/triumph-manipulator-landing/dist/
!workspaces/triumph-manipulator-landing/dist/**

# Triumph Manipulator Landing V2 — explicit allow-list (mirrors V1 policy)
!workspaces/triumph-manipulator-landing-v2/
workspaces/triumph-manipulator-landing-v2/*
!workspaces/triumph-manipulator-landing-v2/README.md
!workspaces/triumph-manipulator-landing-v2/V2-HANDOFF.md
!workspaces/triumph-manipulator-landing-v2/.gitkeep
!workspaces/triumph-manipulator-landing-v2/.gitignore
!workspaces/triumph-manipulator-landing-v2/package.json
!workspaces/triumph-manipulator-landing-v2/package-lock.json
!workspaces/triumph-manipulator-landing-v2/gulpfile.js
!workspaces/triumph-manipulator-landing-v2/src/
!workspaces/triumph-manipulator-landing-v2/src/**
!workspaces/triumph-manipulator-landing-v2/dist/
!workspaces/triumph-manipulator-landing-v2/dist/**
