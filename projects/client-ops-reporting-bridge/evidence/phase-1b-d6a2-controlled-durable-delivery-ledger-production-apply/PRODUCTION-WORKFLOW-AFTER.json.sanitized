      {
        "parameters": {
          "jsCode": "const j = $input.first().json || {};\nreturn [{\n  json: {\n    http_status: j.http_status,\n    response: j.response,\n    evidence: j.evidence || {},\n    received_at: j.received_at || null,\n  }\n}];"
