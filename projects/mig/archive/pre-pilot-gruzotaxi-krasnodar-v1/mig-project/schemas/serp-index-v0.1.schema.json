{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mig:serp-index-v0.1",
  "title": "MIG SERP Index v0.1",
  "description": "Session-level index for multi-query SERP captures (per-query files)",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "aggregation_model",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "session_id": { "type": "string" },
    "aggregation_model": {
      "enum": ["per_query_files", "legacy_single"]
    },
    "default_scope": { "type": "object" },
    "query_set": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query_id", "query_text", "role"],
        "properties": {
          "query_id": { "type": "string", "pattern": "^q[0-9]{2}$" },
          "query_text": { "type": "string" },
          "role": {
            "enum": [
              "primary",
              "supporting",
              "wording_variant",
              "commercial_variant",
              "geo_variant"
            ]
          },
          "execution_status": {
            "enum": ["pending", "captured", "failed", "skipped"]
          },
          "skip_reason": { "type": "string" }
        }
      }
    },
    "queries_declared": {
      "type": "array",
      "items": { "type": "string" }
    },
    "queries_executed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["query_id", "status"],
        "properties": {
          "query_id": { "type": "string" },
          "query_text": { "type": "string" },
          "role": { "type": "string" },
          "artifact_path": { "type": "string" },
          "captured_at": { "type": "string", "format": "date-time" },
          "source_mode": { "enum": ["manual", "provider", "fallback"] },
          "status": {
            "enum": ["pending", "captured", "failed", "skipped"]
          }
        }
      }
    },
    "capture_metadata": {
      "type": "object",
      "properties": {
        "indexed_at": { "type": "string", "format": "date-time" },
        "operator_id": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "safe_unknown": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
