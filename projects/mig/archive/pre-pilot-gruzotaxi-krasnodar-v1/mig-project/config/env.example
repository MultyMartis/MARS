# MIG v0.1 Session Spine — environment variables
# Copy to n8n environment or host .env as needed.

# Root directory for session folders (Node.js CLI / paths.js fallback when unset)
MIG_SESSION_ROOT=C:\AI MARS\projects\mig\sessions

# Task File Adapter inbox (drop zone; fallback: repo incoming/mig)
MIG_INBOX_ROOT=C:\AI MARS\incoming\mig

# Optional: absolute path to session-spine lib (Node.js CLI only in v0.1)
MIG_LIB_ROOT=C:\AI MARS\projects\mig\lib\session-spine

# n8n self-hosted (required for Code nodes with require/fs)
# NODE_FUNCTION_ALLOW_BUILTIN=fs,path,crypto
# NODE_FUNCTION_ALLOW_EXTERNAL=*
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Optional: SERP provider credentials (not used in v0.1 spine — reserved)
# MIG_SERP_PROVIDER=
# MIG_SERP_API_KEY=