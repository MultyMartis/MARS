{
  "schema_version": "0",
  "description": "MIG Site Surface Discovery — controlled multi-page acquisition from homepage links",
  "pages_per_domain_min": 3,
  "pages_per_domain_max": 10,
  "pages_per_domain_default": 8,
  "fetch_timeout_ms": 20000,
  "max_redirects": 5,
  "inter_request_delay_ms": 1000,
  "links_cap_per_homepage": 200,
  "priority_groups": [
    "HOME",
    "SERVICE",
    "PRICING",
    "MOVING",
    "LOADERS",
    "CONTACTS",
    "FAQ"
  ],
  "ignore_path_patterns": [
    "/blog",
    "/novosti",
    "/news",
    "/stati",
    "/statyi",
    "/article",
    "/articles",
    "/privacy",
    "/confidential",
    "/politic",
    "/policy",
    "/cookie",
    "/legal",
    "/terms",
    "/soglashenie",
    "/politika",
    "/consent",
    "/personal-data",
    "/user-agreement",
    "/user_agreement",
    "/__user_agreement",
    "/other-documents",
    "/vacancy",
    "/vakansii",
    "/job",
    "/career",
    "/karera",
    "/sitemap",
    "/wp-content",
    "/wp-admin",
    "/wp-json",
    "/xmlrpc",
    "/feed",
    "/comments",
    "/tag/",
    "/category/",
    "/author/"
  ],
  "ignore_path_regex": [
    "\\.(css|js|json|xml|png|jpe?g|gif|svg|webp|pdf|woff2?|ico)$",
    "^/wp-includes/",
    "^/cdn-cgi/"
  ],
  "ignore_anchor_patterns": [
    "политика",
    "конфиденциаль",
    "cookie",
    "ваканс",
    "блог",
    "новост",
    "rss",
    "skip to",
    "согласие",
    "пользовательск",
    "документ"
  ],
  "group_path_patterns": {
    "HOME": ["^/$", "^/index", "^/home/?$"],
    "SERVICE": ["услуг", "service", "gruzovoe", "gruzov", "transport", "perevoz", "taksi", "gazel", "gruz-taxi", "gruzovie"],
    "PRICING": ["цен", "price", "prais", "tarif", "stoimost", "cost", "ceny", "rates"],
    "MOVING": ["pereezd", "переезд", "mebel", "мебел", "kvartir", "квартир", "moving"],
    "LOADERS": ["gruzchik", "gruzchic", "грузчик", "loader", "pogruzh", "pogruz"],
    "CONTACTS": ["contact", "kontakt", "контакт", "about", "o-kompan", "о-комп", "kontakty"],
    "FAQ": ["faq", "vopros", "вопрос", "help", "qa"]
  },
  "group_anchor_patterns": {
    "HOME": ["главн", "home", "на главную"],
    "SERVICE": ["услуг", "грузов", "такси", "перевоз", "газел", "автопарк", "fleet"],
    "PRICING": ["цен", "тариф", "стоимост", "прайс", "price", "расцен"],
    "MOVING": ["переезд", "мебел", "квартир", "moving"],
    "LOADERS": ["грузчик", "погруз", "loader"],
    "CONTACTS": ["контакт", "о компан", "about", "связ"],
    "FAQ": ["вопрос", "faq", "ответ"]
  },
  "page_role_map": {
    "HOME": "homepage",
    "SERVICE": "service",
    "PRICING": "pricing",
    "MOVING": "service",
    "LOADERS": "service",
    "CONTACTS": "contact",
    "FAQ": "faq"
  }
}
