  "dangerous_keywords": [
    {
      "id": "DK-01",
      "term": "wipe",
      "decision": "DENY",
      "reason": "Wipe language implies mass destruction"
    },
    {
      "id": "DK-02",
      "term": "delete everything",
      "decision": "DENY",
      "reason": "Unscoped mass delete intent"
    },
    {
      "id": "DK-03",
      "term": "start fresh",
      "decision": "NEED_HUMAN",
      "reason": "Recovery language — quarantine path required"
    },
    {
      "id": "DK-04",
      "term": "start over",
      "decision": "NEED_HUMAN",
      "reason": "Recovery language"
    },
    {
      "id": "DK-05",
      "term": "rebuild from scratch",
      "decision": "NEED_HUMAN",
      "reason": "Workspace rebuild risk (F-10)"
    }
  ],
  "cleanup_language": [
    {
      "id": "CL-01",
      "pattern": "cleanup\\s+repo",
      "flags": "i",
      "decision": "DENY",
      "reason": "Repo-wide cleanup without scope lock"
    },
    {
      "id": "CL-02",
      "pattern": "clean\\s+up\\s+(the\\s+)?(repo|repository|workspace)",
      "flags": "i",
      "decision": "DENY",
      "reason": "Workspace/repo cleanup language"
    },
    {
      "id": "CL-03",
      "pattern": "remove\\s+unused",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Heuristic unused-file deletion (F-12)"
    },
    {
      "id": "CL-04",
      "pattern": "prune\\s+(governance|registry)",
      "flags": "i",
      "decision": "DENY",
      "reason": "Governance prune without charter (F-14)"
    },
    {
      "id": "CL-05",
      "pattern": "delete\\s+node_modules",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Prefer regen pipeline; task may forbid"
    }
  ],
  "recursive_patterns": [
    {
      "id": "RP-01",
      "pattern": "-Recurse",
      "flags": "i",
      "decision": "DENY",
      "reason": "PowerShell recursion"
    },
    {
      "id": "RP-02",
      "pattern": "\\s-rf\\b",
      "flags": "i",
      "decision": "DENY",
      "reason": "Unix -rf"
    },
    {
      "id": "RP-03",
      "pattern": "rd\\s+/s\\s+/q",
      "flags": "i",
      "decision": "DENY",
      "reason": "Windows silent recursive delete"
    },
    {
      "id": "RP-04",
      "pattern": "Get-ChildItem.*\\|.*Remove-Item",
      "flags": "i",
      "decision": "DENY",
      "reason": "Pipeline mass delete"
    }
  ],
  "mass_replace_patterns": [
    {
      "id": "MR-01",
      "pattern": "search.?replace|mass.?replace|replace.?all",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Mass replace requires glob lock (F-08)"
    },
    {
      "id": "MR-02",
      "pattern": "sed\\s+-i",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "In-place sed — confirm path glob"
    },
    {
      "id": "MR-03",
      "pattern": "powershell.*-replace.*\\*",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Wildcard replace risk"
    }
  ],
  "workspace_delete_patterns": [
