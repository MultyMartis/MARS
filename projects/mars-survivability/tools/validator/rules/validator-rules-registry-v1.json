{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARS Survivability Validator Rules Registry v1",
  "version": "1.0.0",
  "status": "documented",
  "description": "Human-maintained pattern registry for scoped-operation-validator-v1.mjs. Not automated enforcement.",
  "meta": {
    "lane": "B",
    "phase": "G2",
    "implements": [
      "projects/mars-survivability/contracts/destructive-operations-policy-v1.md",
      "projects/mars-survivability/registries/protected-zones-registry-v1.md",
      "projects/mars-survivability/registries/enforcement-rules-registry-v1.md"
    ],
    "maintainer_note": "Update when protected-zones or enforcement registry changes. Validator does not auto-sync."
  },
  "decision_precedence": ["DENY", "NEED_HUMAN", "ALLOW"],
  "forbidden_commands": [
    {
      "id": "FC-01",
      "pattern": "rm\\s+-rf",
      "flags": "i",
      "decision": "DENY",
      "reason": "Recursive Unix delete (F-01)"
    },
    {
      "id": "FC-02",
      "pattern": "Remove-Item\\s+.*-Recurse",
      "flags": "i",
      "decision": "DENY",
      "reason": "PowerShell recursive delete (F-01, F-11)"
    },
    {
      "id": "FC-03",
      "pattern": "rd\\s+/s",
      "flags": "i",
      "decision": "DENY",
      "reason": "Windows recursive directory remove"
    },
    {
      "id": "FC-04",
      "pattern": "git\\s+clean",
      "flags": "i",
      "decision": "DENY",
      "reason": "git clean forbidden for AGENT (F-05)"
    },
    {
      "id": "FC-05",
      "pattern": "git\\s+reset\\s+--hard",
      "flags": "i",
      "decision": "DENY",
      "reason": "git reset --hard forbidden for AGENT (F-06)"
    },
    {
      "id": "FC-06",
      "pattern": "git\\s+push\\s+.*--force",
      "flags": "i",
      "decision": "DENY",
      "reason": "Force push (F-07)"
    },
    {
      "id": "FC-07",
      "pattern": "git\\s+push\\s+-f\\b",
      "flags": "i",
      "decision": "DENY",
      "reason": "Force push shorthand (F-07)"
    },
    {
      "id": "FC-08",
      "pattern": "del\\s+\\*\\.\\*",
      "flags": "i",
      "decision": "DENY",
      "reason": "Wildcard mass delete (F-03)"
    },
    {
      "id": "FC-09",
      "pattern": "Remove-Item\\s+\\*\\s+-Recurse",
      "flags": "i",
      "decision": "DENY",
      "reason": "PowerShell wildcard recursive delete (F-03)"
    },
    {
      "id": "FC-10",
      "pattern": "git\\s+checkout\\s+--\\s+\\.",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Mass git restore at cwd — confirm path list"
    },
    {
      "id": "FC-11",
      "pattern": "robocopy\\s+.*/MIR",
      "flags": "i",
      "decision": "DENY",
      "reason": "robocopy mirror — destructive sync"
    },
    {
      "id": "FC-12",
      "pattern": "robocopy\\s+.*/PURGE",
      "flags": "i",
      "decision": "DENY",
      "reason": "robocopy purge — destructive"
    },
    {
      "id": "FC-13",
      "pattern": "rimraf\\b",
      "flags": "i",
      "decision": "DENY",
      "reason": "rimraf recursive delete"
    },
    {
      "id": "FC-14",
      "pattern": "fs\\.rm\\b.*recursive",
      "flags": "i",
      "decision": "DENY",
      "reason": "Node fs.rm recursive delete"
    },
    {
      "id": "FC-15",
      "pattern": "rmdir\\s+/s",
      "flags": "i",
      "decision": "DENY",
      "reason": "Windows recursive rmdir"
    }
  ],
  "dangerous_patterns": [
    {
      "id": "DP-01",
      "pattern": "-Recurse|-rf|/s\\b|/q\\b",
      "flags": "i",
      "decision": "DENY",
      "reason": "Recursive delete flag detected"
    },
    {
      "id": "DP-02",
      "pattern": "format\\s+[a-z]:",
      "flags": "i",
      "decision": "DENY",
      "reason": "Drive format — catastrophic"
    },
    {
      "id": "DP-03",
      "pattern": "git\\s+stash\\s+pop",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Stash pop can affect many files"
    },
    {
      "id": "DP-04",
      "pattern": "git\\s+checkout\\s+--",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Tracked file restore — confirm single path"
    },
    {
      "id": "DP-05",
      "pattern": "git\\s+(add|commit|push|merge|rebase)",
      "flags": "i",
      "decision": "NEED_HUMAN",
      "reason": "Git mutation requires explicit user request"
    }
  ],
