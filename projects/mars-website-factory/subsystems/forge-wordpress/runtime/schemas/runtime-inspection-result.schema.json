{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge-wordpress/runtime-inspection-result.schema.json",
  "title": "Runtime Inspection Result",
  "type": "object",
  "required": ["success", "decision", "phase"],
  "properties": {
    "success": { "type": "boolean" },
    "decision": { "type": "string", "enum": ["ADMIT", "DENY"] },
    "phase": { "type": "string" },
    "operation_id": { "type": "string" },
    "site_id": { "type": "string" },
    "runtime_binding_id": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "inspection_result": { "type": "object" },
    "mutation_verdict": { "type": "string" },
    "read_only": { "type": "boolean" },
    "no_write_verdict": { "type": "boolean" },
    "emergency_stop": { "type": "boolean" }
  }
}
