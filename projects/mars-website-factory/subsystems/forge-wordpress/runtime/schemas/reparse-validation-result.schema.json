{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge-wordpress/reparse-validation-result.schema.json",
  "title": "Reparse Validation Result",
  "type": "object",
  "required": ["checked", "allowed", "logical_path", "physical_path", "allowed_root", "reparse_points", "escape_detected", "reason_codes"],
  "properties": {
    "checked": { "type": "boolean" },
    "allowed": { "type": "boolean" },
    "logical_path": { "type": "string" },
    "physical_path": { "type": "string" },
    "allowed_root": { "type": "string" },
    "allowed_physical_root": { "type": "string" },
    "reparse_points": { "type": "array" },
    "escape_detected": { "type": "boolean" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "volume": { "type": "string" }
  }
}
