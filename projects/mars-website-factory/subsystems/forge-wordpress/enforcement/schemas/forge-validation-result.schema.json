{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-validation-result.schema.json",
  "title": "Forge Path Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed",
    "reason_codes",
    "raw_path",
    "normalized_path",
    "allowed_root",
    "is_descendant",
    "requires_reparse_check"
  ],
  "properties": {
    "allowed": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_path": { "type": "string" },
    "normalized_path": { "type": "string" },
    "allowed_root": { "type": "string" },
    "is_descendant": { "type": "boolean" },
    "protected_root_match": {
      "type": ["string", "null"]
    },
    "requires_reparse_check": { "type": "boolean" }
  }
}
