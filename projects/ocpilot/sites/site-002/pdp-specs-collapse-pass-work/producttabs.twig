<section class="product-content">
  <div class="container">





    <div class="product-content__grid product-content__grid--with-side">

      <div class="product-content__main">

        <section class="product-content__specifications product-content__card">
          <h3 class="section-title__like-h3">Характеристики</h3>
          <div class="spec-table">
            {% if attribute_groups %}
            {% for ag in attribute_groups %}
              {% if ag.attribute %}
                {% for a in ag.attribute %}
                <div class="spec-table__row">
                  <div class="spec-table__key"><span>{{ a.name }}</span></div>
                  <div class="spec-table__val">{{ a.text }}</div>
                </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
            {% endif %}
          </div>
          <div class="product-content__specs-toggle-wrap" hidden>
            <button class="product-content__specs-toggle" type="button" data-product-specs-toggle aria-expanded="false">
              <span data-product-specs-toggle-text>Смотреть все характеристики</span>
              <i class="fal fa-chevron-down" aria-hidden="true" data-product-specs-toggle-icon></i>
            </button>
          </div>
        </section>

      </div>

      <aside class="product-content__side">

        {% if description|striptags|trim %}
        <section class="product-content__description product-content__card">
          <h3 class="section-title__like-h3">Описание</h3>
          <div class="content">
            {{ description }}
          </div>
        </section>
        {% endif %}

        <section class="product-content__documents product-content__card">
          <h3 class="section-title__like-h3">Документы</h3>
          {% if documents %}
          <ul class="docs-list">
            {% for d in documents %}
              {% set type_label = {
                'pdf': 'PDF',
                'word': 'DOC',
                'excel': 'XLS',
                'png': 'PNG',
                'jpg': 'JPG',
                'webp': 'WEBP'
              }[d.type]|default('FILE') %}
              <li class="docs-list__item">
                <a class="docs-list__link {{ d.type }}" href="{{ d.filename }}" download>
                  <span class="docs-list__file-main">
                    <span class="docs-list__file-title">{{ d.name }}</span>
                    <span class="docs-list__file-type">{{ type_label }}</span>
                  </span>
                  <span class="docs-list__download" aria-hidden="true">
                    <i class="fad fa-download"></i>
                  </span>
                </a>
              </li>
            {% endfor %}
          </ul>
          <div class="product-content__docs-note">
            <i class="fal fa-info-circle" aria-hidden="true"></i>
            <span>Если вам нужны дополнительные документы&nbsp;&mdash; <a href="#" data-fancybox data-src="#zpmFbQuestion" data-zpm-fb-mode="2">свяжитесь с&nbsp;нами</a>.</span>
          </div>
          {% else %}
          <div class="product-content__docs-empty">
            <i class="fal fa-file-alt" aria-hidden="true"></i>
            <strong>Документация по запросу</strong>
            <span>Подготовим нужные файлы для вашего проекта.</span>
            <a href="#" data-fancybox data-src="#zpmFbQuestion" data-zpm-fb-mode="2">Запросить документы</a>
          </div>
          {% endif %}
        </section>





      </aside>

