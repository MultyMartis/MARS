<section class="product-tabs">
  <div class="container">
    <div class="product-pdp-sections">

      {% if description %}
      <div class="product-pdp-section product-pdp-section--desc">
        <h2 class="product-pdp-section__title section-title__like-h3">Описание</h2>
        <div class="product-pdp-section__body product-pdp-section__body--content">
          <div class="content">
            {{ description }}
          </div>
        </div>
      </div>
      {% endif %}

      {% if attribute_groups %}
      <div class="product-pdp-section product-pdp-section--full-specs">
        <h2 class="product-pdp-section__title section-title__like-h3">Полные характеристики</h2>
        <div class="product-pdp-section__body">
          <div class="spec-table">
            {% for ag in attribute_groups %}
              {% if ag.attribute %}
                {% for a in ag.attribute %}
                <div class="spec-table__row">
                  <div class="spec-table__key">{{ a.name }}</div>
                  <div class="spec-table__val">{{ a.text }}</div>
                </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}

      {% if documents %}
      <div class="product-pdp-section product-pdp-section--docs">
        <h2 class="product-pdp-section__title section-title__like-h3">Документы</h2>
        <div class="product-pdp-section__body product-pdp-section__body--docs">
          <ul class="docs-list">
            {% for d in documents %}
            <li class="docs-list__item">
              <a class="docs-list__link {{ d.type }}" href="{{ d.filename }}" download>{{ d.name }}</a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endif %}

    </div>

    <!-- ===== НОВЫЙ БЛОК ===== -->
    <div class="product-help">

      <div class="product-help__content">

        <div class="product-help__left">

          <div class="product-help__title section-title__like-h2">
            Поможем подобрать и&nbsp;уточнить детали
          </div>

          <div class="product-help__text">
            Подскажем по&nbsp;размерам, материалам и&nbsp;срокам поставки. Проверим, подойдёт&nbsp;ли оборудование под ваши задачи и&nbsp;условия. При необходимости предложим альтернативу или комплектацию.
          </div>

          <button type="button"
            class="btn btn_dark"
            data-fancybox
            data-src="#zpmFbQuestion"
            data-zpm-fb-mode="2">
            Задать вопрос
          </button>

        </div>

<div class="product-help__right">

  <div class="product-help__visual">

    <img src="/assets/img/product-help-visual.png" alt="Подбор оборудования">

  </div>

</div>

      </div>

    </div>
    <!-- ===== /НОВЫЙ БЛОК ===== -->

  </div>
</section>
