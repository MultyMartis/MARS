{{ header }}

<main class="main zpm-about-page">

  {# §01 — Hero #}
  <section class="zpm-about-hero">
    <div class="container">
      <div class="zpm-about-hero__grid">
        <div class="zpm-about-hero__content">
          <p class="zpm-about-hero__lead">ООО &laquo;Завод пищевого машиностроения&raquo; (ЗПМ)&nbsp;&mdash; российский производитель нейтрального оборудования из&nbsp;нержавеющей стали для предприятий общественного питания, торговли и&nbsp;пищевой промышленности. Предприятие основано в&nbsp;2010&nbsp;году. Производство, офис и&nbsp;отгрузка серийной продукции расположены в&nbsp;Барнауле.</p>
          <ul class="zpm-about-hero__trust" aria-label="Ключевые преимущества">
            <li class="zpm-about-hero__trust-item">
              <span class="zpm-about-hero__trust-icon" aria-hidden="true"><i class="fad fa-industry-alt"></i></span>
              <span class="zpm-about-hero__trust-text">Собственное производство в&nbsp;Барнауле</span>
            </li>
            <li class="zpm-about-hero__trust-item">
              <span class="zpm-about-hero__trust-icon" aria-hidden="true"><i class="fad fa-badge-check"></i></span>
              <span class="zpm-about-hero__trust-text">Сертифицированная продукция</span>
            </li>
            <li class="zpm-about-hero__trust-item">
              <span class="zpm-about-hero__trust-icon" aria-hidden="true"><i class="fad fa-ruler-combined"></i></span>
              <span class="zpm-about-hero__trust-text">Изготовление по&nbsp;размерам заказчика</span>
            </li>
          </ul>
        </div>
        <figure class="zpm-about-hero__media">
          <img
            src="/assets/img/corporate/about-intro.jpg"
            alt="Производственная площадка завода пищевого машиностроения ЗПМ"
            width="640"
            height="480"
            loading="eager"
          />
          <figcaption class="zpm-about-hero__caption">Производственная площадка ЗПМ в&nbsp;Барнауле</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {# §02 — About company + proof cards #}
  <section class="zpm-about-company">
    <div class="container">
      <div class="zpm-about-company__head">
        <h2 class="zpm-about-company__title section-title__like-h2">Завод пищевого машиностроения</h2>
        <p class="zpm-about-company__text">ЗПМ&nbsp;&mdash; производитель, а&nbsp;не&nbsp;перекупщик. Компания специализируется на&nbsp;разработке и&nbsp;выпуске нейтрального оборудования для ресторанов, кафе, столовых, пищевых цехов и&nbsp;складских зон. Заказчик работает с&nbsp;юридическим лицом-производителем и&nbsp;может проверить адрес производства и&nbsp;реквизиты на&nbsp;странице <a href="/contact/">Контакты</a>.</p>
      </div>
      <div class="zpm-about-proof__grid">
        <article class="zpm-about-proof-card">
          <span class="zpm-about-proof-card__icon" aria-hidden="true"><i class="fad fa-industry"></i></span>
          <div class="zpm-about-proof-card__body">
            <h3 class="zpm-about-proof-card__title">Собственное производство</h3>
            <p class="zpm-about-proof-card__text">Производим оборудование на&nbsp;собственном предприятии в&nbsp;Барнауле без посредников.</p>
          </div>
        </article>
        <article class="zpm-about-proof-card">
          <span class="zpm-about-proof-card__icon" aria-hidden="true"><i class="fad fa-file-certificate"></i></span>
          <div class="zpm-about-proof-card__body">
            <h3 class="zpm-about-proof-card__title">Документы для&nbsp;закупки</h3>
            <p class="zpm-about-proof-card__text">Предоставляем сертификаты, паспорта и&nbsp;сопроводительную документацию по&nbsp;запросу.</p>
          </div>
        </article>
        <article class="zpm-about-proof-card">
          <span class="zpm-about-proof-card__icon" aria-hidden="true"><i class="fad fa-star"></i></span>
          <div class="zpm-about-proof-card__body">
            <h3 class="zpm-about-proof-card__title">Сделано в&nbsp;России</h3>
            <p class="zpm-about-proof-card__text">Продукция выпускается в&nbsp;России и&nbsp;участвует в&nbsp;программе &laquo;Сделано в&nbsp;России&raquo;.</p>
          </div>
        </article>
        <article class="zpm-about-proof-card">
          <span class="zpm-about-proof-card__icon" aria-hidden="true"><i class="fad fa-truck-moving"></i></span>
          <div class="zpm-about-proof-card__body">
            <h3 class="zpm-about-proof-card__title">Поставки по&nbsp;всей России</h3>
            <p class="zpm-about-proof-card__text">Отгружаем оборудование транспортными компаниями в&nbsp;регионы России.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {# §03 — Production advantages #}
  <section class="zpm-about-advantages">
    <div class="container">
      <h2 class="zpm-about-advantages__title section-title__like-h2">Производство и&nbsp;возможности</h2>
      <div class="zpm-adv-cards" data-adv-cards>
        <div class="zpm-adv-cards__grid zpm-adv-cards__grid--row4 line_version">
          <article class="zpm-adv-card">
            <div class="zpm-adv-card__txt">
              <h3>Собственное производство</h3>
              <p>Металлообработка, сборка и&nbsp;отгрузка на&nbsp;площадке в&nbsp;Барнауле.</p>
            </div>
            <div class="zpm-adv-card__img">
              <img src="/assets/img/advant/adv-instock.png" alt="" width="200" height="160" loading="lazy" />
            </div>
          </article>
          <article class="zpm-adv-card">
            <div class="zpm-adv-card__txt">
              <h3>Контроль качества</h3>
              <p>Продукция проходит проверку перед отгрузкой вместе с&nbsp;комплектом документов.</p>
            </div>
            <div class="zpm-adv-card__img">
              <img src="/assets/img/advant/adv-quality-prod.png" alt="" width="200" height="160" loading="lazy" />
            </div>
          </article>
          <article class="zpm-adv-card">
            <div class="zpm-adv-card__txt">
              <h3>Изготовление на&nbsp;заказ</h3>
              <p>Нестандартные размеры и&nbsp;комплектация по&nbsp;согласованному техническому заданию.</p>
            </div>
            <div class="zpm-adv-card__img">
              <img src="/assets/img/advant/adv-in-order.png" alt="" width="200" height="160" loading="lazy" />
            </div>
          </article>
          <article class="zpm-adv-card">
            <div class="zpm-adv-card__txt">
              <h3>Поставки по&nbsp;России</h3>
              <p>Отгрузка со&nbsp;склада производителя и&nbsp;доставка транспортными компаниями.</p>
            </div>
            <div class="zpm-adv-card__img">
              <img src="/assets/img/advant/adv-trans-company.png" alt="" width="200" height="160" loading="lazy" />
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  {# §04 — Certificates #}
  <section class="zpm-about-certs">
    <div class="container">
      <div class="zpm-about-certs__grid">
        <div class="zpm-about-certs__content">
          <h2 class="zpm-about-certs__title section-title__like-h2">Документы и&nbsp;соответствие</h2>
          <p class="zpm-about-certs__text">На&nbsp;продукцию выдаётся комплект документов в&nbsp;соответствии с&nbsp;категорией оборудования. Компания участвует в&nbsp;программе добровольной сертификации &laquo;Сделано в&nbsp;России&raquo;.</p>
          <p class="zpm-about-certs__meta"><strong>Регистрационный номер&nbsp;&mdash; СС.002662.</strong> Срок действия&nbsp;&mdash; с&nbsp;20.10.2025 по&nbsp;19.10.2028.</p>
          <p class="zpm-about-certs__note">Сертификат подтверждает участие в&nbsp;программе и&nbsp;производство в&nbsp;РФ. Он&nbsp;не&nbsp;заменяет обязательные документы соответствия.</p>
          <a class="zpm-commercial-trust__cert-all" href="/our-certification">Все сертификаты</a>
        </div>
        <div class="zpm-commercial-trust__cert-col zpm-about-certs__cert" aria-label="Сертификат">
          <div class="zpm-commercial-trust__cert-card">
            <a
              class="zpm-commercial-trust__cert-link"
              href="/assets/img/certificates/certificat_00.jpg"
              data-fancybox="certificates-about"
              data-caption="Сертификат «Сделано в России»"
            >
              <img
                class="zpm-commercial-trust__cert-img"
                src="/assets/img/certificates/thumb_00.png"
                alt="Сертификат «Сделано в России»"
                width="200"
                height="280"
                loading="lazy"
              />
            </a>
          </div>
          <div class="zpm-commercial-trust__cert-card--base">
            <img src="/assets/img/sert-base.jpg" alt="" width="250" height="40" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {# §05 — Geography & logistics #}
  <section class="zpm-about-geo">
    <div class="container">
      <div class="zpm-about-geo__grid">
        <figure class="zpm-about-geo__media">
          <img
            src="/assets/img/about-logistics.jpg"
            alt="Отгрузка оборудования ЗПМ со склада производителя"
            width="640"
            height="480"
            loading="lazy"
          />
        </figure>
        <div class="zpm-about-geo__content">
          <h2 class="zpm-about-geo__title section-title__like-h2">География и&nbsp;логистика</h2>
          <ul class="zpm-about-geo__list">
            <li>Доставка по&nbsp;территории РФ</li>
            <li>Отгрузка через транспортные компании</li>
            <li>Документы для закупки и&nbsp;сопровождение отгрузки</li>
            <li>Самовывоз в&nbsp;Барнауле и&nbsp;со&nbsp;склада партнёра в&nbsp;Московской области</li>
          </ul>
          <a class="btn btn_dark zpm-about-geo__link" href="/delivery">Подробнее о&nbsp;доставке</a>
        </div>
      </div>
    </div>
  </section>

<section class="zpm-corp-cta zpm-corp-cta--about" id="zpm-about-cta" aria-labelledby="zpm-about-cta-title" data-corp-cta="about">
    <div class="container">
      <div class="zpm-corp-cta__card">
        <div class="zpm-corp-cta__wrap">
          <div class="zpm-corp-cta__info">
            <div class="zpm-corp-cta__header">
              <p class="zpm-corp-cta__label">Связаться с&nbsp;заводом</p>
              <h2 class="zpm-corp-cta__title" id="zpm-about-cta-title">Получите прайс-лист, консультацию или подбор оборудования</h2>
              <p class="zpm-corp-cta__lead">Поможем подобрать оборудование под задачу предприятия, рассчитаем стоимость и&nbsp;сроки, подготовим коммерческое предложение и&nbsp;ответим по&nbsp;документам для закупки.</p>
            </div>
            <div class="zpm-corp-cta__main">
              <div class="zpm-corp-cta__cert-col" aria-label="Сертификаты">
                <div class="zpm-corp-cta__cert-card">
                  <div class="swiper js-commercial-trust-certs">
                    <div class="swiper-wrapper">
                      <div class="swiper-slide">
                        <a
                          class="zpm-corp-cta__cert-link"
                          href="/assets/img/certificates/certificat_00.jpg"
                          data-fancybox="certificates-about"
                          data-caption="Сертификат «Сделано в России»"
                        >
                          <img
                            class="zpm-corp-cta__cert-img"
                            src="/assets/img/certificates/thumb_00.png"
                            alt="Сертификат «Сделано в России»"
                            width="200"
                            height="280"
                            loading="lazy"
                          />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="zpm-corp-cta__cert-card--base">
                  <img src="/assets/img/sert-base.jpg" alt="" width="250" height="40" loading="lazy" />
                </div>
              </div>
              <div class="zpm-corp-cta__benefits">
                <ul class="zpm-corp-cta__benefits-grid">
                <li class="zpm-corp-cta__benefit">
                  <span class="zpm-corp-cta__benefit-icon" aria-hidden="true"><i class="fad fa-file-spreadsheet"></i></span>
                  <span class="zpm-corp-cta__benefit-body">
                    <strong class="zpm-corp-cta__benefit-title">Получить прайс-лист</strong>
                    <span class="zpm-corp-cta__benefit-text">Отправим актуальный прайс со&nbsp;всеми сериями и&nbsp;размерами.</span>
                  </span>
                </li>
                <li class="zpm-corp-cta__benefit">
                  <span class="zpm-corp-cta__benefit-icon" aria-hidden="true"><i class="fad fa-comments-alt"></i></span>
                  <span class="zpm-corp-cta__benefit-body">
                    <strong class="zpm-corp-cta__benefit-title">Консультация</strong>
                    <span class="zpm-corp-cta__benefit-text">Ответим по&nbsp;комплектации, срокам и&nbsp;документам до&nbsp;оплаты.</span>
                  </span>
                </li>
                <li class="zpm-corp-cta__benefit">
                  <span class="zpm-corp-cta__benefit-icon" aria-hidden="true"><i class="fad fa-drafting-compass"></i></span>
                  <span class="zpm-corp-cta__benefit-body">
                    <strong class="zpm-corp-cta__benefit-title">Подбор оборудования</strong>
                    <span class="zpm-corp-cta__benefit-text">Подберём решение под кухню, цех или производственный участок.</span>
                  </span>
                </li>
                </ul>
              </div>
            </div>
          </div>
          <div class="zpm-corp-cta__form-wrap">
            <div class="zpm-decoration-with-logo">
              <img src="/assets/img/decor-logo.svg" alt="" width="120" height="120" loading="lazy" />
            </div>
            <div class="zpm-corp-cta__form-col">
              <div class="zpm-corp-cta__form-card" id="zpm-about-cta-form">
                <h3 class="zpm-corp-cta__form-title">Получить <em class="no_wrap--word">прайс-лист</em></h3>
                <p class="zpm-corp-cta__form-note">Отправим <em class="zpm-accent-text">актуальный <em class="no_wrap--word">прайс-лист</em></em> и&nbsp;поможем подобрать оптимальное решение под ваши задачи.</p>
<form class="zpm-form" action="#" method="post">
  <input type="hidden" name="dialog" value="7">
  <div class="zpm-form__grid">
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="aboutCtaName">Имя<em>*</em></label>
      <input
        class="zpm-form__input"
        id="aboutCtaName"
        name="name"
        type="text"
        placeholder="Введите ваше имя"
        required
      />
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="aboutCtaPhone">Номер телефона<em>*</em></label>
      <div class="zpm-form__phone">
        <input
          class="zpm-form__input"
          id="aboutCtaPhone"
          name="phone"
          type="tel"
          placeholder="+7 (___) ___-__-__"
          data-mask="phone"
          required
        />
      </div>
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="aboutCtaEmail">E-mail<em>*</em></label>
      <input
        class="zpm-form__input"
        id="aboutCtaEmail"
        name="email"
        type="email"
        placeholder="name@domain.ru"
        data-validate="email"
        required
      />
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="aboutCtaMsg">Комментарий</label>
      <textarea
        class="zpm-form__textarea"
        id="aboutCtaMsg"
        name="message"
        rows="3"
        placeholder="Опишите задачу или интересующие позиции"
      ></textarea>
    </div>
    <div class="zpm-form__field">
      <span class="zpm-form__check-text">
        <em>*</em>&mdash;&nbsp;Обязательно для заполнения.
      </span>
    </div>
    <div class="zpm-form__actions">
      <button class="btn btn_dark zpm-form__submit" type="submit">Отправить заявку</button>
      <label class="zpm-form__agree">
        <input class="zpm-form__checkbox" type="checkbox" name="agree" />
        <span class="zpm-form__agree-text">
          Я&nbsp;даю согласие на&nbsp;обработку своих <a href="/user-agreement/" target="_blank">персональных данных</a>, обратный&nbsp;звонок и&nbsp;соглашаюсь с&nbsp;<a href="/privacy-policy/" target="_blank">политикой конфиденциальности</a>.
        </span>
      </label>
    </div>
  </div>
</form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

{{ footer }}
