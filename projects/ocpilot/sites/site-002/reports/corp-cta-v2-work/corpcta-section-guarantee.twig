<form class="zpm-form zpm-warranty-form" action="#" method="post" novalidate>
  <div class="zpm-form__grid">
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="warrantyName">Имя<em>*</em></label>
      <input class="zpm-form__input" id="warrantyName" name="name" type="text" placeholder="Ваше имя" required />
    </div>
    <div class="zpm-form__field">
