      <div class="zpm-form__phone">
        <input class="zpm-form__input" id="warrantyPhone" name="phone" type="tel" placeholder="+7 (___) ___-__-__" data-mask="phone" required />
      </div>
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="warrantyEmail">E-mail<em>*</em></label>
      <input class="zpm-form__input" id="warrantyEmail" name="email" type="email" placeholder="example@company.ru" data-validate="email" required />
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="warrantyEquipmentModel">Модель оборудования<em>*</em></label>
      <input class="zpm-form__input" id="warrantyEquipmentModel" name="equipment_model" type="text" placeholder="Например: Стол производственный СП-1200/600" required />
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="warrantyPurchaseDate">Дата покупки</label>
      <input class="zpm-form__input" id="warrantyPurchaseDate" name="purchase_date" type="text" placeholder="ДД.ММ.ГГГГ" />
    </div>
    <div class="zpm-form__field zpm-form__field--full">
      <label class="zpm-form__label" for="warrantyComment">Описание неисправности<em>*</em></label>
      <textarea class="zpm-form__textarea" id="warrantyComment" name="comment" rows="4" placeholder="Что произошло, когда заметили, при каких условиях работает оборудование" required></textarea>
    </div>
    <div class="zpm-form__field zpm-form__field--full">
      <p class="zpm-warranty-form__helper">Укажите рабочие контакты и&nbsp;максимально точное описание неисправности. Если есть документы на&nbsp;покупку и&nbsp;фото дефекта — менеджер попросит направить их&nbsp;удобным способом после первичного звонка или письма.</p>
    </div>
    <div class="zpm-form__field">
      <span class="zpm-form__check-text"><em>*</em>&nbsp;— обязательно для заполнения</span>
    </div>
    <div class="zpm-form__actions">
      <button class="btn btn_dark zpm-form__submit" type="submit">Отправить обращение</button>
      <label class="zpm-form__agree">
        <input class="zpm-form__checkbox" type="checkbox" name="agree" required />
        <span class="zpm-form__agree-text">Я&nbsp;даю согласие на&nbsp;обработку своих персональных данных, обратный звонок и&nbsp;соглашаюсь с&nbsp;<a href="/privacy-policy">политикой конфиденциальности</a>.</span>
