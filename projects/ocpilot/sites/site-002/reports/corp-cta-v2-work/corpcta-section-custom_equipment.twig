  <section class="zpm-corp-cta zpm-corp-cta--custom" id="zpm-custom-cta" aria-labelledby="zpm-custom-cta-title" data-corp-cta="custom">
    <div class="container">
      <div class="zpm-corp-cta__card">
        <div class="zpm-corp-cta__wrap">
          <div class="zpm-corp-cta__info">
            <div class="zpm-corp-cta__header">
              <p class="zpm-corp-cta__label">Оборудование на&nbsp;заказ</p>
              <h2 class="zpm-corp-cta__title" id="zpm-custom-cta-title">Получить расчёт изделия под ваш объект</h2>
              <p class="zpm-corp-cta__lead">Опишите задачу — тип изделия, размеры, назначение и&nbsp;регион поставки. Менеджер свяжется с&nbsp;вами, уточнит параметры и&nbsp;подготовит расчёт. Если удобнее начать с&nbsp;телефона — позвоните по&nbsp;номеру, указанному в&nbsp;шапке сайта.</p>
            </div>
            <div class="zpm-corp-cta__main">
              <div class="zpm-corp-cta__cert-col" aria-label="Сертификаты">
                <div class="zpm-corp-cta__cert-card">
                  <div class="swiper js-commercial-trust-certs">
                    <div class="swiper-wrapper">
                      <div class="swiper-slide">
                        <a
                          class="zpm-corp-cta__cert-link"
                          href="/assets/img/certificates/certificat_00.jpg"
                          data-fancybox="certificates-custom"
                          data-caption="Сертификат «Сделано в России»"
                        >
                          <img
                            class="zpm-corp-cta__cert-img"
                            src="/assets/img/certificates/thumb_00.png"
                            alt="Сертификат «Сделано в России»"
                            width="200"
                            height="280"
                            loading="lazy"
                          />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="zpm-corp-cta__cert-card--base">
                  <img src="/assets/img/sert-base.jpg" alt="" width="250" height="40" loading="lazy" />
                </div>
              </div>
              <div class="zpm-corp-cta__benefits">
                <ul class="zpm-corp-cta__benefits-grid">
                <li class="zpm-corp-cta__benefit">
                  <span class="zpm-corp-cta__benefit-icon" aria-hidden="true"><i class="fad fa-ruler-combined"></i></span>
                  <span class="zpm-corp-cta__benefit-body">
                    <strong class="zpm-corp-cta__benefit-title">Нестандартные размеры</strong>
                    <span class="zpm-corp-cta__benefit-text">Изготовим изделие по&nbsp;вашим параметрам и&nbsp;условиям объекта.</span>
                  </span>
                </li>
                <li class="zpm-corp-cta__benefit">
                  <span class="zpm-corp-cta__benefit-icon" aria-hidden="true"><i class="fad fa-cogs"></i></span>
                  <span class="zpm-corp-cta__benefit-body">
                    <strong class="zpm-corp-cta__benefit-title">Производство на&nbsp;заказ</strong>
                    <span class="zpm-corp-cta__benefit-text">Полный цикл на&nbsp;площадке в&nbsp;Барнауле без посредников.</span>
                  </span>
                </li>
                <li class="zpm-corp-cta__benefit">
                  <span class="zpm-corp-cta__benefit-icon" aria-hidden="true"><i class="fad fa-calculator"></i></span>
                  <span class="zpm-corp-cta__benefit-body">
                    <strong class="zpm-corp-cta__benefit-title">Расчёт стоимости</strong>
                    <span class="zpm-corp-cta__benefit-text">Подготовим предварительный расчёт после уточнения параметров.</span>
                  </span>
                </li>
                </ul>
              </div>
            </div>
          </div>
          <div class="zpm-corp-cta__form-wrap">
            <div class="zpm-decoration-with-logo">
              <img src="/assets/img/decor-logo.svg" alt="" width="120" height="120" loading="lazy" />
            </div>
            <div class="zpm-corp-cta__form-col">
              <div class="zpm-corp-cta__form-card" id="zpm-custom-form">
                <h3 class="zpm-corp-cta__form-title">Заявка на&nbsp;расчёт</h3>
                <p class="zpm-corp-cta__form-note">Заполните поля ниже. Поля, отмеченные звёздочкой, обязательны.</p>
<form class="zpm-form zpm-custom-form" action="#" method="post" novalidate>
  <input type="hidden" name="dialog" value="7">
  <div class="zpm-form__grid">
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="customCompany">Организация<em>*</em></label>
      <input class="zpm-form__input" id="customCompany" name="company" type="text" placeholder="Полное или сокращённое наименование" required />
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="customContact">Контактное лицо<em>*</em></label>
      <input class="zpm-form__input" id="customContact" name="contact" type="text" placeholder="ФИО" required />
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="customPhone">Номер телефона<em>*</em></label>
      <div class="zpm-form__phone">
        <input class="zpm-form__input" id="customPhone" name="phone" type="tel" placeholder="+7 (___) ___-__-__" data-mask="phone" required />
      </div>
    </div>
    <div class="zpm-form__field">
      <label class="zpm-form__label" for="customEmail">E-mail<em>*</em></label>
      <input class="zpm-form__input" id="customEmail" name="email" type="email" placeholder="example@company.ru" data-validate="email" required />
    </div>
    <div class="zpm-form__field zpm-form__field--full">
      <label class="zpm-form__label" for="customProjectDescription">Описание задачи<em>*</em></label>
      <textarea class="zpm-form__textarea" id="customProjectDescription" name="project_description" rows="4" placeholder="Назначение, размеры, комплектация, особенности монтажа" required></textarea>
    </div>
    <div class="zpm-form__field zpm-form__field--full">
      <label class="zpm-form__label" for="customDrawings">Чертёж, эскиз или описание файлов</label>
      <textarea class="zpm-form__textarea" id="customDrawings" name="drawings" rows="3" placeholder="Опишите приложенные материалы или укажите, что отправите отдельно"></textarea>
    </div>
    <div class="zpm-form__field zpm-form__field--full">
      <label class="zpm-form__label" for="customNotes">Дополнительные примечания</label>
      <textarea class="zpm-form__textarea" id="customNotes" name="notes" rows="3" placeholder="Срок, регион поставки, ссылка на&nbsp;модель каталога и&nbsp;другое"></textarea>
    </div>
    <div class="zpm-form__field zpm-form__field--full">
      <p class="zpm-custom-form__helper">Файлы чертежей, эскизов или фото можно направить на&nbsp;<a href="mailto:info@bzpm.ru">info@bzpm.ru</a> — укажите в&nbsp;письме номер заявки или название организации после отправки формы.</p>
    </div>
    <div class="zpm-form__field">
      <span class="zpm-form__check-text"><em>*</em>&nbsp;— обязательно для заполнения</span>
    </div>
    <div class="zpm-form__actions">
      <button class="btn btn_dark zpm-form__submit" type="submit" aria-label="Отправить заявку на расчёт оборудования на заказ">Отправить заявку на&nbsp;расчёт</button>
      <label class="zpm-form__agree">
        <input class="zpm-form__checkbox" type="checkbox" name="agree" required />
        <span class="zpm-form__agree-text">Я&nbsp;согласен на&nbsp;обработку персональных данных в&nbsp;соответствии с&nbsp;<a href="/privacy-policy">политикой конфиденциальности</a> и&nbsp;даю согласие на&nbsp;связь по&nbsp;указанным контактам для ответа на&nbsp;заявку.</span>
      </label>
    </div>
  </div>
</form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
