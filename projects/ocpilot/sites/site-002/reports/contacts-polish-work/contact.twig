{{ header }}

<main class="main">

  {# SECTION 1 — contact cards #}
  <section class="zpm-contact-cards">
    <div class="container">
      <div class="zpm-contact-cards__grid">

        <div class="zpm-contact-card">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fad fa-map-marked-alt"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">Адрес</div>
            <div class="zpm-contact-card__value" data-address-field="address">656011, Россия, Алтайский&nbsp;край, г.&nbsp;Барнаул, проспект Калинина,&nbsp;15В</div>
          </div>
          <a class="zpm-contact-card__action" href="https://yandex.ru/maps/?text=656011%2C%20%D0%91%D0%B0%D1%80%D0%BD%D0%B0%D1%83%2C%20%D0%BF%D1%80%D0%BE%D1%81%D0%BF%D0%B5%D0%BA%D1%82%20%D0%9A%D0%B0%D0%BB%D0%B8%D0%BD%D0%B8%D0%BD%D0%B0%2C%2015%D0%92" target="_blank" rel="noopener noreferrer">Построить маршрут</a>
        </div>

        <div class="zpm-contact-card">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fad fa-phone-alt"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">Телефон</div>
            <a class="zpm-contact-card__value zpm-contact-card__value--link" href="tel:+73852721890" data-city-field="phone_link">
              <span data-city-field="phone_text">8 (3852) 72-18-90</span>
            </a>
          </div>
          <button
            type="button"
            class="zpm-contact-card__action zpm-contact-card__action--btn"
            data-fancybox
            data-src="#zpmFbCallback"
            data-zpm-fb-mode="2"
          >Заказать звонок</button>
        </div>

        <div class="zpm-contact-card">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fad fa-envelope-open-text"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">E-mail</div>
            <a class="zpm-contact-card__value zpm-contact-card__value--link" href="mailto:barnaul@bzpm.ru" data-email-field="email_link">
              <span data-email-field="email_text">barnaul@bzpm.ru</span>
            </a>
          </div>
          <button
            type="button"
            class="zpm-contact-card__action zpm-contact-card__action--btn"
            data-fancybox
            data-src="#zpmFbQuestion"
            data-zpm-fb-mode="2"
          >Написать нам</button>
        </div>

        <div class="zpm-contact-card">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fad fa-clock"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">График работы</div>
            <div class="zpm-contact-card__value" data-schedule-field="schedule">ПН-ПТ с&nbsp;9:00 до&nbsp;18:00, БРН</div>
            <div class="zpm-contact-card__hint">Без перерыва</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# SECTION 1B — messenger cards #}
  <section class="zpm-contact-cards zpm-contact-cards--messengers">
    <div class="container">
      <div class="zpm-contact-cards__grid zpm-contact-cards__grid--messengers">

        <div class="zpm-contact-card zpm-contact-card--static">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fad fa-comments-alt"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">MAX</div>
            <div class="zpm-contact-card__value">Мессенджер MAX</div>
          </div>
        </div>

        <div class="zpm-contact-card zpm-contact-card--static">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fab fa-telegram-plane"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">Telegram</div>
            <div class="zpm-contact-card__value">Канал в&nbsp;Telegram</div>
          </div>
        </div>

        <div class="zpm-contact-card zpm-contact-card--static">
          <span class="zpm-contact-card__icon" aria-hidden="true"><i class="fab fa-whatsapp"></i></span>
          <div class="zpm-contact-card__body">
            <div class="zpm-contact-card__title">WhatsApp</div>
            <div class="zpm-contact-card__value">Чат в&nbsp;WhatsApp</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# SECTION 2 — company summary #}
  <section class="zpm-contact-summary">
    <div class="container">
      <div class="zpm-contact-summary__card">
        <div class="zpm-contact-summary__visual" aria-hidden="true">
          <div class="zpm-contact-summary__visual-inner">
            <img class="zpm-contact-summary__logo" src="/assets/img/zpm_logo.svg" alt="" width="160" height="48" loading="lazy" />
            <span class="zpm-contact-summary__visual-caption">Завод пищевого машиностроения</span>
          </div>
        </div>
        <div class="zpm-contact-summary__content">
          <h2 class="zpm-contact-summary__title section-title__like-h2">Завод пищевого машиностроения</h2>
          <ul class="zpm-contact-summary__facts">
            <li class="zpm-contact-summary__fact zpm-contact-summary__fact--icon">
              <span class="zpm-contact-summary__fact-icon" aria-hidden="true"><i class="fad fa-industry-alt"></i></span>
              <span>Собственное производство в&nbsp;Барнауле</span>
            </li>
            <li class="zpm-contact-summary__fact zpm-contact-summary__fact--icon">
              <span class="zpm-contact-summary__fact-icon" aria-hidden="true"><i class="fad fa-file-certificate"></i></span>
              <span>Документы для закупки</span>
            </li>
            <li class="zpm-contact-summary__fact zpm-contact-summary__fact--icon">
              <span class="zpm-contact-summary__fact-icon" aria-hidden="true"><i class="fad fa-badge-check"></i></span>
              <span>Сертифицированная продукция</span>
            </li>
            <li class="zpm-contact-summary__fact">Отгрузка по&nbsp;всей России</li>
          </ul>
          <p class="zpm-contact-summary__text">Производим нейтральное оборудование из&nbsp;нержавеющей стали для предприятий общественного питания, торговли и&nbsp;пищевой промышленности.</p>
        </div>
      </div>
    </div>
  </section>

  {# SECTION 3 — requisites + form + directions #}
  <section class="zpm-contact-details">
    <div class="container">
      <div class="zpm-contact-details__grid">

        <div class="zpm-contact-panel zpm-contact-panel--requisites">
          <h2 class="zpm-contact-panel__title section-title__like-h3">Реквизиты компании</h2>
          <div class="zpm-contact-panel__body">
            <p class="zpm-contact-requisites__line">Общество с&nbsp;ограниченной ответственностью «ЗАВОД ПИЩЕВОГО МАШИНОСТРОЕНИЯ»</p>
            <p class="zpm-contact-requisites__line">ИНН&nbsp;2221237587</p>
            <p class="zpm-contact-requisites__line">КПП&nbsp;222101001</p>
            <p class="zpm-contact-requisites__line">ОГРН&nbsp;1172225049787</p>
            <p class="zpm-contact-requisites__line">Юридический адрес: 656011, Россия, г.&nbsp;Барнаул, пр-т Калинина, 15в, оф.&nbsp;110</p>
            <p class="zpm-contact-requisites__line">Фактический адрес: 656011, Россия, г.&nbsp;Барнаул, пр-т Калинина, 15в, оф.&nbsp;110</p>
          </div>
        </div>

        {{ blockanyquestionsform }}

        <div class="zpm-contact-panel zpm-contact-panel--directions">
          <h2 class="zpm-contact-panel__title section-title__like-h3">Как добраться</h2>
          <ul class="zpm-contact-directions">
            <li class="zpm-contact-directions__item">
              <span class="zpm-contact-directions__icon" aria-hidden="true"><i class="fad fa-truck"></i></span>
              <div class="zpm-contact-directions__body">
                <div class="zpm-contact-directions__label">На автомобиле</div>
                <p class="zpm-contact-directions__text">Двигайтесь по&nbsp;проспекту Калинина до&nbsp;производственной зоны.</p>
              </div>
            </li>
            <li class="zpm-contact-directions__item">
              <span class="zpm-contact-directions__icon" aria-hidden="true"><i class="fad fa-bus-alt"></i></span>
              <div class="zpm-contact-directions__body">
                <div class="zpm-contact-directions__label">Общественным транспортом</div>
                <p class="zpm-contact-directions__text">Остановка рядом с&nbsp;производственной зоной. Уточняйте маршрут по&nbsp;картам.</p>
              </div>
            </li>
            <li class="zpm-contact-directions__item">
              <span class="zpm-contact-directions__icon" aria-hidden="true"><i class="fad fa-dolly-flatbed"></i></span>
              <div class="zpm-contact-directions__body">
                <div class="zpm-contact-directions__label">Самовывоз и&nbsp;отгрузка</div>
                <p class="zpm-contact-directions__text">Отгрузка продукции осуществляется по&nbsp;адресу: г.&nbsp;Барнаул, пр-т Калинина,&nbsp;15В.</p>
              </div>
            </li>
          </ul>
          <a class="btn btn_dark zpm-contact-directions__btn" href="https://yandex.ru/maps/?text=656011%2C%20%D0%91%D0%B0%D1%80%D0%BD%D0%B0%D1%83%2C%20%D0%BF%D1%80%D0%BE%D1%81%D0%BF%D0%B5%D0%BA%D1%82%20%D0%9A%D0%B0%D0%BB%D0%B8%D0%BD%D0%B8%D0%BD%D0%B0%2C%2015%D0%92" target="_blank" rel="noopener noreferrer">Построить маршрут</a>
        </div>

      </div>
    </div>
  </section>

{{ yandexmap }}

</main>

{{ footer }}
