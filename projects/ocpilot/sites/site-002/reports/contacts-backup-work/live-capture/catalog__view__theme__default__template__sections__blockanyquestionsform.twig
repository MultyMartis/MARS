<section class="zpm-any-questions">
  <div class="container">

    <div class="zpm-universal__grid">





      <div class="zpm-universal__grid-First">

        <span>
          <div class="section-title__like-h2">Остались<br />вопросы?</div>
        </span>

        <span>
          <div class="zpm-dealers__text">
            <p>
              Отправьте заявку и&nbsp;наши менеджеры свяжутся с&nbsp;вами в&nbsp;ближайшее время!
            </p>
          </div>

        </span>

      </div>



      <div class="zpm-universal__grid-Second">
      <div class="zpm-dealers__right">

        <!-- Это отдельная форма, не копия блока стань Дилером -->
        <form class="zpm-form" action="#" method="post">
          <div class="zpm-form__grid">
            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerName">Имя<em>*</em></label>
              <input
                class="zpm-form__input"
                id="dealerName"
                name="name"
                type="text"
                placeholder="Введите ваше имя"
                required
              />
            </div>

            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerPhone">Номер телефона<em>*</em></label>
              <div class="zpm-form__phone">
                <!-- <span class="zpm-form__flag" aria-hidden="true"></span> -->
                <input
                  class="zpm-form__input"
                  id="dealerPhone"
                  name="phone"
                  type="tel"
                  placeholder="+7 (___) ___-__-__"
                  data-mask="phone"
                  required
                />
              </div>
            </div>

            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerEmail">E-mail <em>*</em></label>
              <input
                class="zpm-form__input"
                id="dealerEmail"
                name="email"
                type="email"
                placeholder="name@domain.ru"
                data-validate="email"
                required
              />
            </div>

            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerMsg">Вопрос</label>
              <textarea
                class="zpm-form__textarea"
                id="dealerMsg"
                name="message"
                rows="4"
                placeholder="Напишите ваш вопрос"
              ></textarea>
            </div>

            <div class="zpm-form__field">
              <span class="zpm-form__check-text">
                <em>*</em>&mdash;&nbsp;Обязательно для заполнения.
              </span>
            </div>

            <div class="zpm-form__actions">
              <button class="btn btn_dark zpm-form__submit" type="submit">Отправить</button>
                <label class="zpm-form__agree">
                  <input class="zpm-form__checkbox" type="checkbox" name="agree" />
                  <span class="zpm-form__agree-text">
                    Я&nbsp;даю согласие на&nbsp;обработку своих <a href="/user-agreement/" target="_blank">персональных данных</a>, обратный&nbsp;звонок и&nbsp;соглашаюсь с&nbsp;<a href="/privacy-policy/" target="_blank">политикой конфиденциальности</a>.
                  </span>
                </label>
            </div>
          </div>
        </form>
      </div>
      </div>

    </div>
  </div>
</section>
