<section class="certificates">
  <div class="container">

    <div class="zpm-slider__head">

      <div class="section-title__like-h2">Наши<br />сертификаты</div>

      <div class="zpm-slider__btn_wrap certificates__nav--desktop">
        <button class="zpm-slider__btn certificates__btn--prev" type="button" aria-label="Предыдущий">
          <svg class="zpm-icon" aria-hidden="true" focusable="false"><use href="#zpm_ico__btn_back"></use></svg>
        </button>
        <button class="zpm-slider__btn certificates__btn--next" type="button" aria-label="Следующий">
          <svg class="zpm-icon" aria-hidden="true" focusable="false"><use href="#zpm_ico__btn_next"></use></svg>
        </button>
      </div>

    </div>

    <!-- Slider -->
    <div class="swiper js-certificates-slider">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <a
            class="certificates__card"
            href="/assets/img/certificates/certificat_00.jpg"
            data-fancybox="certificates"
          >
            <img
              class="certificates__img"
              src="/assets/img/certificates/thumb_00.png"
              alt="Сертификат 1"
            />
          </a>
        </div>

        <div class="swiper-slide">
          <a
            class="certificates__card"
            href="/assets/img/certificates/certificat_01.jpg"
            data-fancybox="certificates"
          >
            <img
              class="certificates__img"
              src="/assets/img/certificates/thumb_01.png"
              alt="Сертификат 2"
            />
          </a>
        </div>

        <div class="swiper-slide">
          <a
            class="certificates__card"
            href="/assets/img/certificates/certificat_01.jpg"
            data-fancybox="certificates"
          >
            <img
              class="certificates__img"
              src="/assets/img/certificates/thumb_01.png"
              alt="Сертификат 3"
            />
          </a>
        </div>

        <div class="swiper-slide">
          <a
            class="certificates__card"
            href="/assets/img/certificates/certificat_01.jpg"
            data-fancybox="certificates"
          >
            <img
              class="certificates__img"
              src="/assets/img/certificates/thumb_01.png"
              alt="Сертификат 4"
            />
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
