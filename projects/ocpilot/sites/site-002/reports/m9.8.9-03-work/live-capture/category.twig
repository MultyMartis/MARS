{{ header }}

<main class="main">


<section class="category{% if category_display_mode == 'hub' %} category--hub{% endif %}">
{% if category_display_mode != 'hub' %}
<script>
(function () {
  var el = document.currentScript.parentElement;
  try {
    if (window.matchMedia('(min-width: 1025px)').matches && localStorage.getItem('zpm_category_view') === 'list') {
      el.classList.add('category--view-list');
    }
  } catch (e) {}
})();
</script>
{% endif %}
  <div class="container">

    <div class="category__layout">

      {% if category_display_mode != 'hub' %}
      <aside class="category__sidebar" data-filter-sidebar aria-hidden="true">
        <div class="category__sidebar__overlay" data-filter-close tabindex="-1" aria-hidden="true"></div>
        <div class="category__sidebar__panel" role="dialog" aria-modal="true" aria-label="Фильтры">
          <div class="zpm-popup_manager__head">
            Поиск по параметрам
          </div>
          <button class="zpm-popup_close" type="button" data-filter-close aria-label="Закрыть окно" title="Закрыть окно">
            <svg class="zpm-icon" aria-hidden="true" focusable="false"><use href="#zpm_ico__close"></use></svg>
          </button>
          <div class="filter-mobile__body">
            {{ filter }}
          </div>
        </div>
      </aside>
      {% endif %}

      <div class="category__content">

        {% if category_display_mode == 'hub' %}

        <section class="zpm-cat-sections" data-cat-sections>
          <div class="zpm-cat-sections__grid-wrapper">
            <div class="zpm-cat-sections__grid">
              {% if hub_categories %}
              {% for cat in hub_categories %}
                <a class="zpm-cat-card" href="{{ cat.href }}">
                  <div class="zpm-cat-card__title">{{ cat.name }}</div>
                  <div class="zpm-cat-card__img">
                    <img src="{{ cat.thumb300 }}" alt="{{ cat.name }}">
                  </div>
                  <div class="zpm-cat-card__ico_arrow">
                    <svg class="zpm-icon" aria-hidden="true" focusable="false"><use href="#zpm_ico__goto_btn_arrow"></use></svg>
                  </div>
                </a>
              {% endfor %}
              {% endif %}
            </div>
          </div>
        </section>

        {% else %}

{% if categories %}
<div class="zpm-sub-cat-chips" data-subcat-chips>
  <span class="zpm-sub-cat-chip--title"><i class="fal fa-sitemap" aria-hidden="true"></i> Подкатегории:</span>
  <div class="zpm-sub-cat-chips__list" data-subcat-chips-list>
  {% for c in categories %}
    <a class="zpm-sub-cat-chip" href="{{ c.href }}">
      {% if c.thumb %}
      <span class="zpm-sub-cat-chip__icon">
        <img src="{{ c.thumb }}" alt="{{ c.name }}">
      </span>
      {% endif %}
      <span class="zpm-sub-cat-chip__text">
        {{ c.name }}
      </span>
    </a>
  {% endfor %}
  </div>
  <button type="button" class="zpm-sub-cat-chips__toggle" data-subcat-chips-toggle hidden aria-expanded="false">
    <span data-subcat-chips-toggle-label>Показать все подкатегории</span>
    <i class="fal fa-chevron-down" data-subcat-chips-toggle-chevron aria-hidden="true"></i>
  </button>
</div>
{% endif %}

        <div class="category__topbar category__topbar--mobile">

          <div class="category__topbar__wrap-left">
            <div class="category__sort">
              <span class="category__sort-label">Сортировать&nbsp;по:</span>
              <button class="category__sort-btn" type="button" data-sort-open aria-expanded="false">
                <span class="category__sort-btn-text">{{ sorttext }}</span>
              </button>
              <div class="category__sort-menu" data-sort-menu hidden>
                <button class="category__sort-item" type="button" data-sort="sort=p.date_added&order=DESC">Умолчанию</button>
                <button class="category__sort-item" type="button"  data-sort="sort=p.price&order=ASC">Сначала дешевле</button>
                <button class="category__sort-item" type="button" data-sort="sort=p.price&order=DESC">Сначала дороже</button>
                <button class="category__sort-item" type="button" data-sort="sort=pd.name&order=ASC">Название -&nbsp;от&nbsp;А до&nbsp;Я</button>
                <button class="category__sort-item" type="button" data-sort="sort=pd.name&order=DESC">Название -&nbsp;от&nbsp;Я до&nbsp;А</button>
              </div>
            </div>

            <div class="category__limit">
              <span class="category__sort-label">Показывать&nbsp;по:</span>
              <button class="category__sort-btn" type="button" data-limit-open aria-expanded="false">
                <span class="category__sort-btn-text">{{ limit }}</span>
              </button>
              <div class="category__sort-menu" data-limit-menu hidden>
                {% for l in limits %}
                <a class="category__sort-item{% if l.value == limit %} is-active{% endif %}" href="{{ l.href }}">{{ l.text }}</a>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="category__view" data-category-view role="group" aria-label="Вид каталога">
            <button type="button" class="category__view-btn is-active" data-category-view-mode="grid" aria-pressed="true" aria-label="Сетка" title="Сетка">
              <i class="fad fa-th-large"></i>
            </button>
            <button type="button" class="category__view-btn" data-category-view-mode="list" aria-pressed="false" aria-label="Список" title="Список">
              <i class="fad fa-th-list"></i>
            </button>
          </div>

          <button class="category__filters-btn" type="button" data-filter-open aria-expanded="false">
            Фильтры
          </button>

        </div>

        <div class="category__grid">
          {% if productcards %}
          {% for p in productcards %}
            {{ p }}
          {% endfor %}
          {% endif %}
        </div>

        {{ pagination }}

        {% endif %}

      </div>
    </div>
  </div>
</section>

{{ seotext }}
{{ certificates }}
{{ blockdealersform }}

</main>

{{ footer }}
