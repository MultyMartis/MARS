<section class="zpm-commercial-trust zpm-dealers" data-commercial-trust data-dealers>
  <div class="container">

    <div class="zpm-commercial-trust__strip" aria-label="Сертификаты качества">
      <p class="zpm-commercial-trust__strip-label">Сертифицированная продукция</p>
      <div class="zpm-commercial-trust__certs">
        <a
          class="zpm-commercial-trust__cert"
          href="/assets/img/certificates/certificat_00.jpg"
          data-fancybox="certificates-plp"
          data-caption="Сертификат 1"
        >
          <img
            class="zpm-commercial-trust__cert-img"
            src="/assets/img/certificates/thumb_00.png"
            alt="Сертификат 1"
            width="120"
            height="170"
            loading="lazy"
          />
        </a>
        <a
          class="zpm-commercial-trust__cert"
          href="/assets/img/certificates/certificat_01.jpg"
          data-fancybox="certificates-plp"
          data-caption="Сертификат 2"
        >
          <img
            class="zpm-commercial-trust__cert-img"
            src="/assets/img/certificates/thumb_01.png"
            alt="Сертификат 2"
            width="120"
            height="170"
            loading="lazy"
          />
        </a>
        <a
          class="zpm-commercial-trust__cert-all"
          href="/assets/img/certificates/certificat_00.jpg"
          data-fancybox="certificates-plp"
        >Все сертификаты</a>
      </div>
    </div>

    <div class="zpm-commercial-trust__split">
      <div class="zpm-commercial-trust__copy">
        <h2 class="zpm-commercial-trust__title">Дилерам и&nbsp;оптовикам</h2>
        <ul class="zpm-commercial-trust__bullets">
          <li>Собственное производство нейтрального оборудования</li>
          <li>Работаем по&nbsp;всей России</li>
          <li>Сертифицированная продукция</li>
          <li>Гарантия производителя</li>
          <li>Помощь в&nbsp;подборе оборудования</li>
        </ul>
        <a class="btn zm-inline-btn zpm-commercial-trust__more" href="/dealers">Подробнее</a>
      </div>

      <div class="zpm-commercial-trust__form-card">
        <form class="zpm-form" action="#" method="post">
          <input type="hidden" name="dialog" value="7">
          <div class="zpm-form__grid">
            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerName">Имя<em>*</em></label>
              <input
                class="zpm-form__input"
                id="dealerName"
                name="name"
                type="text"
                placeholder="Введите ваше имя"
                required
              />
            </div>
            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerPhone">Номер телефона<em>*</em></label>
              <div class="zpm-form__phone">
                <input
                  class="zpm-form__input"
                  id="dealerPhone"
                  name="phone"
                  type="tel"
                  placeholder="+7 (___) ___-__-__"
                  data-mask="phone"
                  required
                />
              </div>
            </div>
            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerEmail">E-mail <em>*</em></label>
              <input
                class="zpm-form__input"
                id="dealerEmail"
                name="email"
                type="email"
                placeholder="name@domain.ru"
                data-validate="email"
                required
              />
            </div>
            <div class="zpm-form__field">
              <label class="zpm-form__label" for="dealerMsg">Вопрос</label>
              <textarea
                class="zpm-form__textarea"
                id="dealerMsg"
                name="message"
                rows="3"
                placeholder="Напишите ваш вопрос"
              ></textarea>
            </div>
            <div class="zpm-form__field">
              <span class="zpm-form__check-text">
                <em>*</em>&mdash;&nbsp;Обязательно для заполнения.
              </span>
            </div>
            <div class="zpm-form__actions">
              <button class="btn btn_dark zpm-form__submit" type="submit">Отправить</button>
              <label class="zpm-form__agree">
                <input class="zpm-form__checkbox" type="checkbox" name="agree" />
                <span class="zpm-form__agree-text">
                  Я&nbsp;даю согласие на&nbsp;обработку своих <a href="/user-agreement/" target="_blank">персональных данных</a>, обратный&nbsp;звонок и&nbsp;соглашаюсь с&nbsp;<a href="/privacy-policy/" target="_blank">политикой конфиденциальности</a>.
                </span>
              </label>
            </div>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>
