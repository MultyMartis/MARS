{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-ppc-state-manifest-v1.schema.json",
  "title": "MARS Search PPC Project State Manifest v1",
  "type": "object",
  "required": [
    "manifest_id",
    "project_id",
    "organization",
    "campaign_platform",
    "campaign_type",
    "region",
    "current_lifecycle_stage",
    "stage_statuses",
    "artifacts"
  ],
  "properties": {
    "manifest_id": { "type": "string" },
    "project_id": { "type": "string" },
    "organization": { "type": "string" },
    "campaign_platform": { "const": "Yandex Direct" },
    "campaign_type": { "const": "search" },
    "region": { "type": "string" },
    "current_lifecycle_stage": { "pattern": "^SPPC-[0-9]{2}$" },
    "lifecycle_contract_ref": { "type": "string" },
    "stage_statuses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" },
          "updated_at": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "status": { "type": "string" },
          "registered_at": { "type": "string" },
          "owner_system": { "type": "string" }
        }
      }
    },
    "source_registry": { "type": "object" },
    "data_collection_periods": { "type": "object" },
    "operator_approvals": { "type": "object" },
    "degraded_evidence_approvals": { "type": "object" },
    "blockers": { "type": "array" },
    "next_required_action": { "type": "string" },
    "runtime_versions": { "type": "object" },
    "final_launch_authority": { "type": "object" }
  }
}
