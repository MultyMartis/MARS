{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-search-ppc-task-contract-v1.schema.json",
  "title": "MARS Search PPC Cursor Task Contract v1",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "manifest_path",
    "lifecycle_stage",
    "requested_transition",
    "authoritative_inputs",
    "required_outputs",
    "forbidden_outputs",
    "validator_command_before",
    "validator_command_after",
    "expected_status_transition",
    "git_scope"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "project_id": { "type": "string" },
    "manifest_path": { "type": "string" },
    "lifecycle_stage": { "pattern": "^SPPC-[0-9]{2}$" },
    "requested_transition": { "type": "string" },
    "authoritative_inputs": { "type": "array", "items": { "type": "string" } },
    "required_outputs": { "type": "array", "items": { "type": "string" } },
    "forbidden_outputs": { "type": "array", "items": { "type": "string" } },
    "validator_command_before": { "type": "string" },
    "validator_command_after": { "type": "string" },
    "expected_status_transition": { "type": "string" },
    "git_scope": { "type": "array", "items": { "type": "string" } }
  }
}
