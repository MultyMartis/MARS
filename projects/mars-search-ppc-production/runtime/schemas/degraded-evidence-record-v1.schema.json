{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "degraded-evidence-record-v1.schema.json",
  "title": "MARS Search PPC Degraded Evidence Record v1",
  "type": "object",
  "required": [
    "affected_stage",
    "missing_evidence",
    "reason",
    "attempted_collection",
    "failure_evidence",
    "alternative_evidence",
    "impact",
    "operator_approval",
    "approval_timestamp",
    "expiry_or_recheck_condition",
    "downstream_limitations"
  ],
  "properties": {
    "affected_stage": { "pattern": "^SPPC-[0-9]{2}$" },
    "missing_evidence": { "type": "string" },
    "reason": { "type": "string" },
    "attempted_collection": { "type": "string" },
    "failure_evidence": { "type": "string" },
    "alternative_evidence": { "type": "string" },
    "impact": { "type": "string" },
    "operator_approval": { "type": "object" },
    "approved": { "type": "boolean" },
    "approval_timestamp": { "type": "string" },
    "expiry_or_recheck_condition": { "type": "string" },
    "expiry_recheck_condition": { "type": "string" },
    "downstream_limitations": { "type": "array", "items": { "type": "string" } }
  }
}
