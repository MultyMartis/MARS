{
  "schema_version": "search-ppc-regression-corpus-v1",
  "purpose": "Failure-prevention fixtures — NOT automatic semantic authority for future clients",
  "template_contamination": {
    "stale_campaign_negatives": {
      "terms": ["ремонт", "запчасти", "эвакуатор"],
      "source": "Triumph template E9",
      "expected_when_policy_blank": "removed_from_artifact"
    },
    "stale_organization": {
      "values": ["29500847237"],
      "expected_when_policy_blank": "cleared"
    },
    "stale_promotion_url": {
      "values": ["https://manipulator-triumph.ru/"],
      "expected": "cleared_or_replaced"
    }
  },
  "metadata_transport": {
    "explicit_clear_campaign_negatives": {
      "input": { "operation": "clear", "field": "campaign_negatives" },
      "template_e9_populated": true,
      "expected_xlsx_e9": null
    },
    "preserve_campaign_negatives": {
      "input": { "operation": "preserve", "field": "campaign_negatives" },
      "expected": "original_only_where_contract_permits"
    },
    "set_campaign_negatives": {
      "input": { "operation": "set", "value": "-test" },
      "expected_xlsx": "-test"
    },
    "blank_string_must_not_become_preserve": {
      "input": { "operation": "clear" },
      "note": "Empty string via legacy path must map to EXPLICIT_CLEAR not PRESERVE"
    }
  },
  "semantic_reject_examples": [
    "как искать клиентов программисту 1с",
    "мемы про 1с программистов",
    "программист 1с колледж",
    "программист 1с заработная плата",
    "техническое задание на доработку 1с пример",
    "программист 1с описание",
    "программист 1с основы",
    "программист 1с перспективы",
    "интеграция 1с с честным знаком как сделать",
    "ошибки программиста 1с"
  ],
  "semantic_keep_examples": [
    "нужен программист 1с",
    "где найти программиста 1с",
    "ищу 1с программиста для разовой задачи",
    "найти программиста 1с на аутсорсинг",
    "стоимость часа программиста 1с",
    "программист 1с зуп",
    "программист 1с унф",
