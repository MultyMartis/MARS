  ],
  "geo_examples": {
    "Новосибирск": "LOCAL_ONLY",
    "Саратов": "REMOTE_ONLY",
    "Липецк": "REMOTE_ONLY",
    "Улан-Удэ": "REMOTE_ONLY",
    "Минск": "REJECT_RUSSIA_ONLY_SCOPE",
    "Алматы": "REJECT_RUSSIA_ONLY_SCOPE"
  },
  "service_routing_examples": {
    "честный знак маркировка": "CA-05",
    "bitrix site integration": "CA-04",
    "paid 1c support": "CA-02",
    "paid modification": "CA-03",
    "programmer search": "CA-01"
  },
  "group_architecture": {
    "forbidden_generic_ad": "Услуги 1С для бизнеса: настройка, доработки и поддержка.",
    "violations": [
      "one_phrase_group_without_justification",
      "generic_group_unrelated_intents",
      "group_above_maximum",
      "overlapping_duplicate_phrases",
      "missing_ad_for_group",
      "generic_ad_reused_across_groups"
    ]
  },
  "negative_policy": {
    "quoted_pseudo_safe_rejected": ["\"лицензия 1с\"", "\"дистанционно\""],
    "separate_txt_policy": {
      "xlsx_metadata_blank": true,
      "txt_exists": true,
      "txt_validated_independently": true
    }
  },
  "semantic_quality_classes": {
    "deterministic_reject": ["career", "salary", "education", "courses", "templates", "torrent", "named_person_lookup", "foreign_geography", "provider_client_acquisition"],
    "deterministic_keep_candidate": ["explicit_service_order", "price_of_service", "find_contractor", "need_specialist", "paid_modification", "paid_support", "paid_integration"],
    "operator_review_required": ["ambiguous_kak_queries", "short_role_phrases", "brand_ambiguity", "software_operation_queries", "document_commercial_ambiguity", "uncertain_geography"]
  },
  "differential_hotfix_v2_6_to_v2_6_1": {
    "allowed_changes": ["file_version", "timestamps", "checksums", "manifest_references", "e9_clear_operation"],
    "forbidden_changes": ["group_assignment", "phrase_assignment", "ad_text", "bid", "url", "region", "geo_allocation"]
  }
}
