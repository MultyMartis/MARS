{
  "$id": "mars-search-ppc/commander-transport/authority-manifest.schema.json",
  "title": "Commander Transport Authority Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "pilot_id",
    "authority_checkpoint",
    "campaign_scope",
    "files",
    "operator_approval_state",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "pilot_id": { "type": "string", "minLength": 1 },
    "authority_checkpoint": { "type": "string", "minLength": 1 },
    "campaign_scope": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CA-[0-9]{2}$" },
      "minItems": 1
    },
    "operator_approval_state": {
      "type": "string",
      "enum": ["OPERATOR_APPROVED", "APPROVED", "PENDING", "REJECTED"]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256", "required"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
