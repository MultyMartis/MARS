{
  "$id": "mars-search-ppc/commander-transport/validation-result.schema.json",
  "title": "Commander Transport Validation Result",
  "type": "object",
  "required": ["status", "violations", "warnings", "validated_at"],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "validated_at": { "type": "string" },
    "stop_code": { "type": ["string", "null"] },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "campaign_id": { "type": "string" },
          "group_id": { "type": "string" },
          "actual_phrase_count": { "type": "number" },
          "maximum_phrase_count": { "type": "number" },
          "details": { "type": "object" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "cross_campaign_duplicate_report": { "type": "array" },
    "group_phrase_counts": { "type": "object" }
  }
}
