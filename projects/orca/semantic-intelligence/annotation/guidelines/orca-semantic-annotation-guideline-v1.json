  "mandatory_annotation_order": [
    {"step": 1, "name": "read_literally", "field": "literal_interpretation", "eligibility_allowed": false},
    {"step": 2, "name": "identify_likely_next_action", "field": "likely_user_goal", "eligibility_allowed": false},
    {"step": 3, "name": "extract_signals", "field": "signals", "eligibility_allowed": false},
    {"step": 4, "name": "assign_primary_and_secondary_intent", "fields": ["primary_intent", "secondary_intents"], "eligibility_allowed": false},
    {"step": 5, "name": "assess_competing_interpretations", "field": "ambiguity", "eligibility_allowed": false},
    {"step": 6, "name": "assess_provider_hire_likelihood", "eligibility_allowed": false},
    {"step": 7, "name": "check_landing_compatibility", "eligibility_allowed": false},
    {"step": 8, "name": "assign_eligibility", "field": "commercial_eligibility.decision", "eligibility_allowed": true},
    {"step": 9, "name": "assess_risk_and_review", "fields": ["risk", "review"], "eligibility_allowed": true},
    {"step": 10, "name": "record_decision_trace", "fields": ["audit", "versioning"], "eligibility_allowed": true}
  ],
  "mandatory_abstain_ambiguity_types": [
    "PROVIDER_VS_DIY",
    "PRODUCT_VS_SERVICE",
    "CAREER_VS_PROVIDER",
    "SUPPORT_VS_INFORMATION",
    "SHORT_HEAD_TERM",
    "MULTIPLE"
  ],
  "core_distinctions": {
    "primary_intent_not_eligibility": true,
    "topic_not_commercial_intent": true,
    "workflow_status_not_eligibility": true,
    "service_candidate_not_ownership": true,
    "problem_signal_not_provider_hire": true
  },
  "prohibited_terminal_outcomes": [
    "service_mapping",
    "campaign_grouping",
    "cluster_assignment"
  ],
