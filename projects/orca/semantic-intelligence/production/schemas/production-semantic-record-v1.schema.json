{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orca-production-semantic-record-v1",
  "title": "ORCA Production Semantic Record v1",
  "type": "object",
  "required": [
    "phrase_id", "raw_query", "normalized_query", "primary_intent",
    "commercial_eligibility", "decision", "confidence", "timestamps"
  ],
  "properties": {
    "phrase_id": { "type": "string" },
    "raw_query": { "type": "string" },
    "normalized_query": { "type": "string" },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "frequencies": { "type": "object" },
    "region": { "type": "string" },
    "collection_period": { "type": "string" },
    "business_scope_version": { "type": "string" },
    "service_registry_version": { "type": "string" },
    "assessor_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "primary_intent": { "type": "string" },
    "secondary_intent": { "type": ["string", "null"] },
    "commercial_eligibility": { "type": "boolean" },
    "commercial_evidence": { "type": "array" },
    "non_commercial_evidence": { "type": "array" },
    "protected_intent_class": { "type": ["string", "null"] },
    "likely_next_user_action": { "type": "string" },
    "provider_hire_likelihood": { "type": "number" },
    "diy_likelihood": { "type": "number" },
    "career_likelihood": { "type": "number" },
    "education_likelihood": { "type": "number" },
    "navigation_likelihood": { "type": "number" },
    "product_only_likelihood": { "type": "number" },
    "ambiguity_class": { "type": "string" },
    "confidence": { "type": "number" },
    "decision": { "enum": ["ACCEPT", "REJECT", "ABSTAIN"] },
    "rationale": { "type": "string" },
    "alternative_interpretation": { "type": ["string", "null"] },
    "invariant_results": { "type": "array" },
    "reassessment_result": { "type": ["object", "null"] },
    "adjudication_result": { "type": "object" },
    "final_authority": { "type": "string" },
    "output_class": { "type": "string" },
    "review_requirement": { "type": "string" },
    "demand_tier": { "type": ["string", "null"] },
    "ownership": { "type": ["object", "null"] },
    "cluster_id": { "type": ["string", "null"] },
    "timestamps": { "type": "object" }
  }
}
