{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orca-semantic-assessment-output-v1",
  "title": "ORCA Semantic Assessment Output v1",
  "type": "object",
  "required": [
    "primary_intent",
    "commercial_eligibility",
    "decision",
    "confidence",
    "rationale",
    "blind_assessment"
  ],
  "properties": {
    "primary_intent": { "type": "string" },
    "secondary_intent": { "type": ["string", "null"] },
    "likely_next_action": { "type": "string" },
    "commercial_eligibility": {
      "type": "object",
      "required": ["decision", "confidence"],
      "properties": {
        "decision": { "enum": ["ACCEPT", "REJECT", "ABSTAIN"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "provider_hire_likelihood": { "type": "number" },
    "diy_likelihood": { "type": "number" },
    "career_likelihood": { "type": "number" },
    "education_likelihood": { "type": "number" },
    "informational_likelihood": { "type": "number" },
    "navigation_likelihood": { "type": "number" },
    "product_only_likelihood": { "type": "number" },
    "protected_intent_class": { "type": ["string", "null"] },
    "commercial_evidence": { "type": "array", "items": { "type": "string" } },
    "non_commercial_evidence": { "type": "array", "items": { "type": "string" } },
    "ambiguity": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": { "enum": ["ACCEPT", "REJECT", "ABSTAIN"] },
    "rationale": { "type": "string" },
    "alternative_interpretation": { "type": ["string", "null"] },
    "missing_context": { "type": "array", "items": { "type": "string" } },
    "blind_assessment": { "type": "boolean" },
    "model_metadata": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model_id": { "type": "string" },
        "prompt_version": { "type": "string" },
        "context_checksum": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
