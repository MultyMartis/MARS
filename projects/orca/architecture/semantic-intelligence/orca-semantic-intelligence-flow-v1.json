{
  "flow_id": "orca-semantic-intelligence-flow",
  "version": "v1",
  "date": "2026-06-22",
  "status": "PROPOSED — OPERATOR APPROVAL REQUIRED",
  "layers": [
    {"id": "SI-01", "name": "Operator Authority", "inputs": ["operator_intake", "service_scope"], "outputs": ["operator_scope_manifest"], "cannot": ["auto_final_keyword_decisions"]},
    {"id": "SI-02", "name": "Market Evidence", "inputs": ["wordstat", "keyword_tools", "serp", "search_terms"], "outputs": ["evidence_packs"], "cannot": ["declare_commercial_eligibility"]},
    {"id": "SI-03", "name": "Source Corpus", "inputs": ["evidence_bindings"], "outputs": ["raw_phrase_ledger"], "cannot": ["normalize_away_meaning", "semantic_decisions"]},
    {"id": "SI-04", "name": "Normalization", "inputs": ["raw_corpus"], "outputs": ["normalized_records"], "cannot": ["invent_commercial_formulations"]},
    {"id": "SI-05", "name": "Query Understanding", "inputs": ["normalized_records", "operator_scope"], "outputs": ["feature_object"], "cannot": ["final_ACCEPT_alone"]},
    {"id": "SI-06", "name": "Hard Exclusion Screening", "inputs": ["features"], "outputs": ["EXCLUDED", "PASS_TO_INTENT"], "cannot": ["classify_ambiguous_problem_as_commercial"]},
    {"id": "SI-07", "name": "Intent Classification", "inputs": ["features", "screening_pass"], "outputs": ["intent_record"], "taxonomy_minimum": ["hire_service", "buy_product_or_module", "technical_support", "troubleshoot_self", "DIY/how-to", "informational", "educational", "career/employment", "regulatory", "navigational", "documentation", "download", "ambiguous", "irrelevant", "malformed"]},
    {"id": "SI-08", "name": "Commercial Eligibility", "inputs": ["intent_record", "operator_scope", "risk_mode"], "outputs": ["ACCEPT", "REJECT", "ABSTAIN"], "cannot": ["ACCEPT_from_service_term_alone"]},
    {"id": "SI-09", "name": "Semantic Adjudication", "inputs": ["ABSTAIN", "escalations"], "outputs": ["resolved_decision", "queue_item"], "authority": "human_operator_final"},
    {"id": "SI-10", "name": "Service Mapping", "inputs": ["ACCEPT_records", "service_scope"], "outputs": ["ownership_mapping"], "cannot": ["change_eligibility"], "runs_after": "ACCEPT"},
    {"id": "SI-11", "name": "Cluster Discovery", "inputs": ["ownership", "intents"], "outputs": ["cluster_candidates"], "cannot": ["campaign_groups", "merge_conflicting_primary_intents"]},
    {"id": "SI-12", "name": "Negative Intelligence", "inputs": ["ownership", "clusters", "prohibited_claims"], "outputs": ["negative_registry"], "cannot": ["rescue_bad_phrases_via_negatives"], "runs_after": ["SI-10", "SI-11"]},
    {"id": "SI-13", "name": "Human Review", "inputs": ["escalations"], "outputs": ["adjudicated_decisions"], "queues": ["ABSTAIN", "protected_strata", "high_risk_ACCEPT", "conflicts", "random_ACCEPT_audit", "random_REJECT_audit", "model_disagreement", "blind_evaluation"]},
    {"id": "SI-14", "name": "Semantic Core Authority", "inputs": ["resolved_phrase_records"], "outputs": ["semantic_core_artifact"], "states": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED", "SUPERSEDED"], "unlocks_SI15_when": "APPROVED"},
    {"id": "SI-15", "name": "Campaign Production Handoff", "inputs": ["APPROVED_core"], "outputs": ["campaign_dataset"], "cannot": ["add_phrases", "alter_semantics"]},
    {"id": "SI-16", "name": "External Artifact QA", "inputs": ["core", "campaign_dataset", "export_artifacts"], "outputs": ["qa_report"], "cannot": ["silent_semantic_repair"]},
    {"id": "SI-17", "name": "Post-Launch Learning", "inputs": ["performance_data"], "outputs": ["proposals"], "cannot": ["mutate_approved_core_without_gate"]}
  ],
  "phrase_state_machine": [
    {"state": "RAW", "next": ["NORMALIZED"]},
    {"state": "NORMALIZED", "next": ["UNDERSTOOD"]},
    {"state": "UNDERSTOOD", "next": ["SCREENED"]},
    {"state": "SCREENED", "next": ["INTENT_CLASSIFIED", "HARD_EXCLUDED"]},
    {"state": "HARD_EXCLUDED", "next": ["REJECTED"]},
    {"state": "INTENT_CLASSIFIED", "next": ["ELIGIBILITY_PENDING"]},
    {"state": "ELIGIBILITY_PENDING", "next": ["ACCEPTED", "REJECTED", "ABSTAINED"]},
    {"state": "ABSTAINED", "next": ["IN_ADJUDICATION"]},
    {"state": "IN_ADJUDICATION", "next": ["ACCEPTED", "REJECTED"]},
    {"state": "ACCEPTED", "next": ["MAPPED"]},
    {"state": "MAPPED", "next": ["CLUSTER_CANDIDATE"]},
    {"state": "CLUSTER_CANDIDATE", "next": ["NEGATIVES_DERIVED"]},
    {"state": "NEGATIVES_DERIVED", "next": ["CORE_DRAFT"]},
    {"state": "CORE_DRAFT", "next": ["IN_REVIEW"]},
    {"state": "IN_REVIEW", "next": ["APPROVED", "REJECTED", "SUPERSEDED"]},
    {"state": "APPROVED", "next": ["CAMPAIGN_CONSUMED"]},
    {"state": "CAMPAIGN_CONSUMED", "next": ["EXPORT_QA"]}
  ],
  "prohibited_shortcuts": [
    "SI02_to_SI08_ACCEPT",
    "SI05_topical_to_ACCEPT",
    "SI11_before_SI08",
    "SI12_before_SI10",
    "SI15_phrase_addition",
    "SI16_semantic_repair",
    "SI17_to_SI14_without_gate",
    "skip_SI14_to_commander"
  ]
}
