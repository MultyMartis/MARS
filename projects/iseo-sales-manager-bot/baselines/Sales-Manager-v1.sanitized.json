    {
      "parameters": {
        "jsCode": "const lead = $node[\"Normalize-Clean-Lead\"].json;\n\nfunction onlyDigits(value) {\n  return String(value || \"\").replace(/\\D/g, \"\");\n}\n\nfunction cleanText(value) {\n  return String(value || \"\")\n    .replace(/^'+/, \"\")\n    .replace(/^#ERROR!.*$/i, \"\")\n    .trim()\n    .toLowerCase();\n}\n\nfunction isRealMessenger(value) {\n  const v = cleanText(value);\n  if (!v) return false;\n  if ([\"telegram\", \"whatsapp\", \"wa\", \"max\", \"телеграм\", \"ватсап\", \"вацап\"].includes(v)) return false;\n  return /^@/.test(v) || /t\\.me\\//.test(v) || onlyDigits(v).length >= 10;\n}\n\nconst leadId = cleanText(lead.lead_id);\nconst leadPhone = onlyDigits(lead.phone || lead.primary_contact);\nconst leadEmail = cleanText(lead.email);\nconst leadMessenger = cleanText(lead.messenger);\nconst leadSite = cleanText(lead.site);\n\nconst rows = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row && Object.keys(row).length > 0);\n\nconst duplicates = rows.filter((row) => {\n  const rowLeadId = cleanText(row.lead_id);\n  const rowPhone = onlyDigits(row.phone || row.primary_contact);\n  const rowEmail = cleanText(row.email);\n  const rowMessenger = cleanText(row.messenger);\n  const rowSite = cleanText(row.site);\n\n  if (leadId && rowLeadId && leadId === rowLeadId) return true;\n  if (leadPhone && rowPhone && leadPhone === rowPhone) return true;\n  if (leadEmail && rowEmail && leadEmail === rowEmail) return true;\n  if (isRealMessenger(leadMessenger) && isRealMessenger(rowMessenger) && leadMessenger === rowMessenger) return true;\n  if (leadSite && rowSite && leadSite === rowSite) return true;\n\n  return false;\n});\n\nlet duplicateStatus = \"new\";\nlet duplicateNote = \"\";\n\nif (duplicates.length > 0) {\n  duplicateStatus = \"repeat\";\n\n  const last = duplicates[duplicates.length - 1];\n\n  duplicateNote = [\n    \"Повторный лид.\",\n    last.created_at ? `Предыдущее обращение: ${last.created_at}` : \"\",\n    last.service ? `Прошлая услуга: ${last.service}` : \"\",\n    last.summary ? `Прошлый смысл: ${last.summary}` : \"\"\n  ]\n    .filter(Boolean)\n    .join(\" \");\n}\n\nreturn [\n  {\n    json: {\n      ...lead,\n      duplicate_status: duplicateStatus,\n      notes: duplicateNote\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
