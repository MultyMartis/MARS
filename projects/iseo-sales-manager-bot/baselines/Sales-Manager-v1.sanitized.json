    {
      "parameters": {
        "chatId": "<MANAGER_CHAT_ID>",
        "text": "={{\n(() => {\n\nfunction esc(text) {\n  return String(text || \"\")\n    .replace(/([_*\\[\\]()~>#+\\-=|{}.!])/g, '\\\\$1');\n}\n\nconst data = $node[\"Mark-Duplicate-Status\"].json;\n\nreturn `🟢 Новый лид\n\nКлиент: ${esc(data.clean_name) || \"не указано\"}\nКонтакт: ${esc(data.primary_contact) || \"не указан\"}\nСайт: ${esc(data.site) || \"не указан\"}\nУслуга: ${esc(data.service) || \"не определена\"}\n\nПовтор: ${esc(data.duplicate_status || \"unknown\")}\n${data.notes ? \"История: \" + esc(data.notes) : \"\"}\n\nКратко:\n${esc(data.summary || \"нет описания\")}\n\nКачество данных: ${esc(data.quality_status || \"unknown\")}\n${data.quality_comment ? \"Комментарий: \" + esc(data.quality_comment) : \"\"}\n\n———————————\nГотовый ответ клиенту:\n${esc(data.ai_reply || \"Ответ пока не сформирован\")}`;\n\n})()\n}}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
