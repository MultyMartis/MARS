    {
      "parameters": {
        "jsCode": "const rawText = ($json.snippet || \"\")\n  .replace(/\\r/g, \"\")\n  .trim();\n\nconst text = rawText.replace(/\\n+/g, \"\\n\");\n\n// ===== helpers =====\n\nfunction getByRegex(regex) {\n  const m = text.match(regex);\n  return m ? m[1].trim() : \"\";\n}\n\n// ===== стандартные поля =====\n\nconst clientName =\n  getByRegex(/От кого:\\s*(.+)/i) ||\n  getByRegex(/Имя:\\s*(.+)/i);\n\nconst phone =\n  getByRegex(/Телефон:\\s*([^\\n]+)/i) ||\n  getByRegex(/Контакт:\\s*([^\\n]+)/i);\n\nconst site =\n  getByRegex(/Адрес сайта:\\s*([^\\n]+)/i);\n\nconst page =\n  getByRegex(/Отправлено со страницы:\\s*(.+)/i);\n\n// ===== калькулятор (01–20) =====\n\nconst calcMatches = [...text.matchAll(/(\\d{2})\\s*:\\s*(.+)/g)];\n\nlet calcData = calcMatches.map(m => `${m[1]}: ${m[2]}`).join(\"; \");\n\n// ===== комментарий =====\n\nlet comment =\n  getByRegex(/Комментарий:\\s*([\\s\\S]*?)(Отправлено со страницы|$)/i);\n\nif (!comment && calcData) {\n  comment = calcData;\n}\n\n// ===== email =====\n\nconst emailMatch = text.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\n\n// ===== финал =====\n\nconst gmailMessageId = $json.id || \"\";\nconst gmailThreadId = $json.threadId || \"\";\n\nreturn [\n  {\n    json: {\n      gmail_message_id: gmailMessageId,\n      gmail_thread_id: gmailThreadId,\n\n      lead_id: gmailMessageId || Date.now().toString(),\n      created_at: new Date(Number($json.internalDate || Date.now())).toISOString(),\n\n      source: \"gmail\",\n      email_subject: $json.subject || \"UNKNOWN\",\n\n      client_name: clientName || \"UNKNOWN\",\n      contact_type: phone ? \"phone\" : \"unknown\",\n      client_contact: phone || emailMatch?.[0] || \"UNKNOWN\",\n\n      client_phone: phone || \"\",\n      client_email: emailMatch ? emailMatch[0] : \"\",\n      client_messenger: \"\",\n\n      client_site: site || \"\",\n      request_text: comment || \"\",\n      request_page: page || \"\",\n      ip: \"\",\n\n      ai_summary: \"\",\n      ai_detected_service: \"\",\n      ai_priority: \"\",\n      ai_reply: \"\",\n\n      manager_status: \"new\",\n      processing_status: \"parsed\",\n\n      // ВАЖНО\n      raw_text: text,\n      calc_detected: calcMatches.length > 0\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1696,
        -512
      ],
      "id": "093b38ca-d589-42ca-b27b-b2f8a92c6216",
      "name": "Lead-Mail-Parser",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const lead = $node[\"Lead-Mail-Parser\"].json;\n\nreturn [\n  {\n    json: {\n      ...lead,\n\n      openrouter_body: {\n        model: \"openai/gpt-4o-mini\",\n        messages: [\n          {\n            role: \"system\",\n            content: \"Ты помощник менеджера веб-студии i-SEO. Анализируй входящие заявки кратко и по делу. Верни только валидный JSON без markdown.\"\n          },\n          {\n            role: \"user\",\n            content: `Проанализируй лид.\n\nСырые данные:\n${lead.raw_text}\n\nДополнительно:\nИмя: ${lead.client_name}\nКонтакт: ${lead.client_contact}\nСайт: ${lead.client_site}\n\nВерни JSON:\n{\n  \"ai_summary\": \"\",\n  \"ai_detected_service\": \"SEO / Direct / Site / Audit / Other\",\n  \"ai_priority\": \"low / normal / high\",\n  \"ai_reply\": \"\",\n  \"quality_status\": \"ok / warning / bad\",\n  \"quality_comment\": \"\"\n}`\n          }\n        ],\n        temperature: 0.2\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1504,
        -512
      ],
      "id": "26f30635-80bc-4434-adda-b7bab6d654b1",
      "name": "Prepare-OpenRouter-Request"
    },
    {
      "parameters": {
        "jsCode": "const lead = $node[\"Lead-Mail-Parser\"].json;\n\nlet content = \"\";\n\ntry {\n  content = $json.choices?.[0]?.message?.content || \"\";\n} catch (e) {\n  content = \"\";\n}\n\nlet ai = {};\n\ntry {\n  ai = JSON.parse(content);\n} catch (e) {\n  ai = {\n    ai_summary: \"AI_PARSE_FAILED\",\n    ai_detected_service: \"Other\",\n    ai_priority: \"normal\",\n    ai_reply: \"\"\n  };\n}\n\nreturn [\n  {\n    json: {\n      ...lead,\n\n      ai_summary: ai.ai_summary || \"\",\n      ai_detected_service: ai.ai_detected_service || \"Other\",\n      ai_priority: ai.ai_priority || \"normal\",\n      ai_reply: ai.ai_reply || \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1872,
        -272
      ],
      "id": "09132381-d7e5-4d31-b230-2be482b75cf4",
      "name": "Normalize-AI-Result"
    },
    {
      "parameters": {
        "jsCode": "const raw = $node[\"Normalize-AI-Result\"].json;\n\nlet content = $json.choices?.[0]?.message?.content || \"\";\nlet clean = {};\n\ntry {\n  clean = JSON.parse(content);\n} catch (e) {\n  clean = {\n    clean_name: raw.client_name,\n    primary_contact: raw.client_contact,\n    phone: raw.client_phone,\n    email: raw.client_email,\n    messenger: raw.client_messenger,\n    site: raw.client_site,\n    service: raw.ai_detected_service || \"Other\",\n    summary: raw.ai_summary,\n    quality_status: \"warning\",\n    quality_comment: \"AI не смог корректно разобрать данные лида.\"\n  };\n}\n\nfunction cleanText(value) {\n  return String(value || \"\")\n    .replace(/^'+/, \"\")\n    .replace(/^=+'+/, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction cleanSite(value) {\n  const site = cleanText(value);\n\n  if (!site) return \"\";\n  if (site === \".\" || site === \"-\" || site === \"—\") return \"\";\n  if (/Комментарий:/i.test(site)) return \"\";\n  if (/Отправлено со страницы:/i.test(site)) return \"\";\n\n  return site;\n}\n\nlet service = cleanText(clean.service || raw.ai_detected_service || \"Other\");\n\nif (!service || service.includes(\"/\")) {\n  service = \"Other\";\n}\n\nconst qualityStatus = cleanText(clean.quality_status) || \"warning\";\nconst qualityComment = cleanText(clean.quality_comment);\n\nreturn [\n  {\n    json: {\n      lead_id: raw.lead_id,\n      created_at: raw.created_at,\n\n      clean_name: cleanText(clean.clean_name || raw.client_name),\n      primary_contact: cleanText(clean.primary_contact || raw.client_contact),\n\n      phone: cleanText(clean.phone || raw.client_phone),\n      email: cleanText(clean.email || raw.client_email),\n      messenger: cleanText(clean.messenger || raw.client_messenger),\n\n      site: cleanSite(clean.site) || cleanSite(raw.client_site),\n\n      service: service,\n      summary: cleanText(clean.summary || raw.ai_summary),\n      ai_reply: cleanText(raw.ai_reply),\n\n      quality_status: qualityStatus,\n      quality_comment: qualityComment,\n\n      duplicate_status: \"unknown\",\n      manager_status: \"new\",\n      notes: \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1312,
