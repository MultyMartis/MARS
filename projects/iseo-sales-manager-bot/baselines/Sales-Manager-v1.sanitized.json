      "parameters": {
        "jsCode": "const lead = $node[\"Normalize-AI-Result\"].json;\n\nreturn [\n  {\n    json: {\n      ...lead,\n\n      openrouter_body: {\n        model: \"openai/gpt-4o-mini\",\n        messages: [\n          {\n            role: \"system\",\n            content: \"Ты нормализатор лидов. Приводи данные к чистому виду. Убирай мусор. Определи основной контакт, услугу и качество данных. Верни только валидный JSON без markdown.\"\n          },\n          {\n            role: \"user\",\n            content: `Сырые данные лида:\n\nИмя: ${lead.client_name}\nТип связи: ${lead.contact_type}\nКонтакт: ${lead.client_contact}\nТелефон: ${lead.client_phone}\nEmail: ${lead.client_email}\nМессенджер: ${lead.client_messenger}\nСайт: ${lead.client_site}\nКомментарий: ${lead.request_text}\nСтраница: ${lead.request_page}\nAI summary: ${lead.ai_summary}\nAI service: ${lead.ai_detected_service}\n\nВерни JSON:\n{\n  \"clean_name\": \"\",\n  \"primary_contact\": \"\",\n  \"phone\": \"\",\n  \"email\": \"\",\n  \"messenger\": \"\",\n  \"site\": \"\",\n  \"service\": \"SEO / Direct / Site / Audit / Other\",\n  \"summary\": \"\",\n  \"quality_status\": \"ok / warning / bad\",\n  \"quality_comment\": \"\"\n}`\n          }\n        ],\n        temperature: 0.1\n      }\n    }\n  }\n];"
