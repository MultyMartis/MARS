      "name": "Manual Admin Synthetic Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        180,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst msg = j.message || j;\nconst text = String(msg.text || j.text || '').trim();\nconst from = msg.from || j.from || {};\nconst chat = msg.chat || j.chat || {};\nconst parts = text.split(/\\s+/);\nconst command = (parts[0] || '').split('@')[0].toLowerCase();\nconst args = parts.slice(1);\nreturn [{ json: {\n  command,\n  args,\n  text,\n  user_id: String(from.id || j.user_id || ''),\n  username: from.username || '',\n  chat_id: String(chat.id || j.chat_id || ''),\n  raw_ok: Boolean(text),\n}}];"
      },
