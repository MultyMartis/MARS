    {
      "parameters": {
        "jsCode": "const j=$input.first().json; const m=j.config_map||{};\nconst lines = [\n  'Healthcheck Sales Manager',\n  'CONFIG: ' + (m.ai_enabled != null ? 'OK' : 'MISSING'),\n  'RAW v2: PENDING_RUNTIME',\n  'CLEAN v2: PENDING_RUNTIME',\n  'LEAD_EVENTS: PENDING_RUNTIME',\n  'ERRORS: PENDING_RUNTIME',\n  'DEDUP_INDEX: PENDING_RUNTIME',\n  'Gmail credential ref: present_in_operational',\n  'Telegram: DISABLED_PENDING_SANDBOX_DEST',\n  'AI: ' + ((m.ai_enabled==='true') ? 'ON' : 'OFF'),\n  'AI probe: ' + ((m.ai_enabled==='true' && m.health_ai_probe_enabled==='true') ? 'ALLOWED' : 'SKIPPED'),\n];\nreturn [{ json: { ...j, reply_text: lines.join('\\n') } }];"
      },
