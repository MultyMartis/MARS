    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst rows = $('Read Authorization Config').all().map(i => i.json);\nconst map = {};\nfor (const r of rows) if (r.key != null) map[String(r.key)] = String(r.value ?? '');\nconst allow = String(map.admin_user_ids || '').split(/[,;\\s]+/).map(s => s.trim()).filter(Boolean);\nconst authorized = allow.length === 0 ? false : allow.includes(String(j.user_id));\n// Fail-closed: empty allowlist => deny state-changing; still allow /help unknown text for UX? Spec: allowlist required for state-changing. Deny all if empty.\nreturn [{ json: { ...j, config_map: map, authorized, environment: map.environment || 'dev', ai_enabled: map.ai_enabled === 'true' } }];"
      },
