        "jsCode": "function safeNodeJson(nodeName) {\n  try {\n    const node = $(nodeName);\n    if (!node || !node.isExecuted) return null;\n    return node.first()?.json || null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction cleanId(value) {\n  return String(value || '').replace(/^=/, '').trim();\n}\n\nconst telegram = safeNodeJson('Telegram Trigger') || {};\nconst buildLock = safeNodeJson('Build User Lock Key') || {};\nconst detect = safeNodeJson('Detect Local Command') || {};\nconst current = $json || {};\n\nconst message =\n  telegram.message ||\n  current.message ||\n  current.body?.message ||\n  {};\n\nconst from = message.from || {};\nconst chat = message.chat || {};\n\nconst command = String(\n  detect.command ||\n  current.command ||\n  ''\n).trim().toLowerCase();\n\nconst isRetrievalOnly = command === 'get';\n\nconst hasRealLock = Boolean(\n  buildLock.lock_key &&\n  buildLock.chat_id\n);\n\nconst lock = hasRealLock && !isRetrievalOnly\n  ? {\n      lock_key: cleanId(buildLock.lock_key),\n      chat_id: cleanId(buildLock.chat_id),\n      user_id: cleanId(buildLock.user_id),\n      username: String(buildLock.username || ''),\n      first_name: String(buildLock.first_name || ''),\n      last_name: String(buildLock.last_name || '')\n    }\n  : null;\n\nconst statusMessageId =\n  current.result?.message_id ||\n  current.message_id ||\n  current.status_message?.message_id ||\n  null;\n\nconst chatId =\n  cleanId(buildLock.chat_id) ||\n  cleanId(detect.chat_id) ||\n  cleanId(chat.id);\n\nreturn [{\n  json: {\n    ...current,\n    worker_payload: {\n      message,\n      lock,\n      status_message: {\n        chat_id: chatId,\n        message_id: statusMessageId\n      }\n    }\n  }\n}];"
