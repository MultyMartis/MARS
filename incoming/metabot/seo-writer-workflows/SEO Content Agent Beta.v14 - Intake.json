    {
      "parameters": {
        "jsCode": "const start = $('Build User Lock Key').first().json;\nconst now = Date.now();\n\nlet activeLock = null;\n\nconst checkedRows = [];\n\nfor (const item of items) {\n  const row = item.json || {};\n\n  const rowLockKey = String(row.lock_key || '').trim();\n  const rowChatId = String(row.chat_id || '').trim();\n  const status = String(row.status || '').trim().toLowerCase();\n  const expiresAtRaw = String(row.expires_at || '').trim();\n  const expiresAt = Date.parse(expiresAtRaw);\n\n  if (!rowLockKey && !rowChatId && !status) {\n    continue;\n  }\n\n  checkedRows.push({\n    lock_key: rowLockKey,\n    chat_id: rowChatId,\n    status,\n    expires_at: expiresAtRaw,\n    expires_valid: Number.isFinite(expiresAt),\n    expires_future: Number.isFinite(expiresAt) ? expiresAt > now : false\n  });\n\n  if (\n    rowChatId === String(start.chat_id) &&\n    status === 'active' &&\n    Number.isFinite(expiresAt) &&\n    expiresAt > now\n  ) {\n    activeLock = row;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ...start,\n    is_busy: Boolean(activeLock),\n    active_lock: activeLock,\n    active_task_id: activeLock?.task_id || '',\n    lock_debug: {\n      input_items: items.length,\n      checked_rows: checkedRows\n    }\n  }\n}];"
      },
