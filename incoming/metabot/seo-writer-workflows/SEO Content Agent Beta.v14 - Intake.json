    {
      "parameters": {
        "jsCode": "const msg = $json.message || {};\nconst text = String(msg.text || '').trim();\n\nconst command =\n  (text.match(/^\\/([a-zA-Z0-9_-]+)/)?.[1] || '').toLowerCase();\n\nconst flags = text.match(/--[a-zA-Z0-9_-]+/g) || [];\n\nlet task_id = '';\n\nif (command === 'get') {\n  task_id = text.match(/^\\/get\\s+([a-zA-Z0-9_-]+)/i)?.[1]?.trim() || '';\n}\n\nif (!task_id) {\n  task_id = text.match(/--from\\s+([a-zA-Z0-9_-]+)/i)?.[1]?.trim() || '';\n}\n\nif (!task_id) {\n  task_id = text.match(/(?:^|\\s)from\\s*:\\s*([a-zA-Z0-9_-]+)/i)?.[1]?.trim() || '';\n}\n\nif (!task_id) {\n  task_id = text.match(/(?:^|\\s)task[_-]?id\\s*:\\s*([a-zA-Z0-9_-]+)/i)?.[1]?.trim() || '';\n}\n\nconst contentCommands = [\n  'run',\n  'outline',\n  'text',\n  'seoqa',\n  'factcheck',\n  'get'\n];\n\nconst localCommands = [\n  'start'\n];\n\nconst adminCommands = [\n  'help',\n  'examples',\n  'locks',\n  'health',\n  'stop-all-flow'\n];\n\nconst knownCommands = [\n  ...localCommands,\n  ...adminCommands,\n  ...contentCommands\n];\n\nconst isUnknownSlashCommand = Boolean(command && !knownCommands.includes(command));\n\nconst isLocalCommand =\n  localCommands.includes(command) ||\n  isUnknownSlashCommand;\n\nconst isAdminCommand =\n  adminCommands.includes(command);\n\n// ВАЖНО:\n// retrieval branch в Intake используем только для /get.\n// --from / from:task_id должны идти через обычную lock-ветку,\n// потому что это новая задача генерации/проверки.\nconst isRetrievalCommand =\n  command === 'get';\n\nlet response_text = '';\n\nif (command === 'start') {\n  response_text = `SEO Content Agent\n\nЯ помогаю готовить SEO-ТЗ, SEO-тексты, QA-проверку и factcheck по заданному брифу.\n\nЧто умею:\n— создавать SEO-ТЗ;\n— писать SEO-тексты;\n— проверять текст по ТЗ;\n— проверять факты и рискованные формулировки;\n— работать в строгом режиме без обещаний и гарантий;\n— сохранять результаты по Task ID.\n\nОсновные команды:\n/run — полный pipeline\n/outline — только SEO-ТЗ\n/text — только SEO-текст\n/seoqa — SEO QA\n/factcheck — фактчек\n/get task-id — получить результат\n/examples — примеры заданий\n/help — справка по командам\n\nДля полного запуска отправьте:\n\n/run --strict\nТип: страница услуги\nТема: SEO-аудит сайта\nТаблицы: да\n\nБриф:\nОпишите услугу, ограничения и важные требования.`;\n}\n\nif (isUnknownSlashCommand) {\n  response_text = `Команда не распознана: /${command}\n\nДоступные команды:\n/run — полный pipeline\n/outline — SEO-ТЗ\n/text — SEO-текст\n/seoqa — SEO QA\n/factcheck — factcheck\n/get task-id — получить сохранённый результат\n/help — справка\n/examples — примеры`;\n}\n\nreturn [{\n  json: {\n    ...$json,\n    chat_id: String(msg.chat?.id || ''),\n    user_id: String(msg.from?.id || ''),\n    username: String(msg.from?.username || ''),\n    first_name: String(msg.from?.first_name || ''),\n    last_name: String(msg.from?.last_name || ''),\n    command,\n    flags,\n    task_id,\n    admin_command: isAdminCommand ? command : '',\n    is_local_command: isLocalCommand,\n    is_admin_command: isAdminCommand,\n    is_retrieval_command: isRetrievalCommand,\n    response_text\n  }\n}];"
      },
