      "parameters": {
        "jsCode": "const msg = $('Telegram Trigger').first().json.message || {};\nconst from = msg.from || {};\n\nconst chatId = String(msg.chat?.id || '');\nconst userId = String(from.id || '');\nconst username = String(from.username || '');\nconst firstName = String(from.first_name || '');\nconst lastName = String(from.last_name || '');\n\nconst baseLockKey = `chat:${chatId}`;\nconst lockKey = `${baseLockKey}:${Date.now()}`;\n\nreturn [{\n  json: {\n    ...$json,\n    chat_id: chatId,\n    user_id: userId,\n    username,\n    first_name: firstName,\n    last_name: lastName,\n    base_lock_key: baseLockKey,\n    lock_key: lockKey\n  }\n}];"
      },
