      "mentions_wp_update": true,
      "mentions_delete": false,
      "requires_wp_load": true,
      "preview_head": "<?php\n/**\n * FP-0002 controlled task: encoding inventory/repair, admin, WPilot config.\n * Local runtime only — not for Git.\n *\n * Usage:\n *   php fp0002-access-encoding-wpilot-task.php inventory\n *   php fp0002-access-encoding-wpilot-task.php repair\n *   php fp0002-access-encoding-wpilot-task.php configure-wpilot\n */\n\ndefine( 'WP_USE_THEMES', false );\nrequire dirname( __DIR__, 2 ) . '/wp-load.php';\n\nif ( ! defined( 'ABSPATH' ) ) {\n\tfwrite( STDERR, \"WordPress bootstrap failed\\n\" );\n\texit( 1 );\n}\n\n$mode = $argv[1] ?? 'inventory';\n\n/**\n * Authority map: slug => canonical title (V9 manifest + foundation populate script).\n *\n * @return array<string,string>\n */\nfunction fp0002_title_authority_map() {\n\treturn array(\n\t\t'glavnaya'                          => 'Главная',\n\t\t'uslugi'                            => 'Услуги',\n\t\t'zavisimosti'                       => 'Зависимости',\n\t\t'psihicheskoe-zdorovie'             => 'Психическое здоровье',\n\t\t'rasstroystva-pischevogo-povedeniya' => 'Расстройства пищевого поведения',\n\t\t'genotipirovanie'                   => 'Генотипирование',\n\t\t'specyalisty'                       => 'Специалисты',\n\t\t'o-centre'                          => 'О центре',\n\t\t'o-nas'                             => 'О нас',\n\t\t'programma-lecheniya'               => 'Программа лечения',\n\t\t'galereya-o-dome'                   => 'Галерея о доме',\n\t\t'specialistam'                      => 'Специалистам',"
    },
    {
      "rel": "mars-runtime/scripts/populate-fp-0002-pages.php",
      "bytes": 4575,
      "sha256": "293c4aa48a8f15f82f170ca6c5cc8c4e9a69a3dc456d71ab080adfc51a8d3a6d",
      "mentions_wp_insert": true,
      "mentions_wp_update": true,
      "mentions_delete": false,
      "requires_wp_load": true,
      "preview_head": "<?php\n/**\n * FP-0002 page skeleton population — FW-06A.\n *\n * Run: php populate-fp-0002-pages.php\n */\n\ndefine( 'WP_USE_THEMES', false );\nrequire dirname( __DIR__, 2 ) . '/wp-load.php';\n\n$placeholder = \"Заглушка локальной разработки.\\nФинальный контент и вёрстка ожидают утверждённого frontend handoff.\";\n\n/**\n * @param string $title Title.\n * @param string $slug Slug.\n * @param int    $parent Parent ID.\n * @return int\n */\nfunction fp0002_create_page( $title, $slug, $parent = 0 ) {\n\tglobal $placeholder;\n\t$existing = get_page_by_path( $slug, OBJECT, 'page' );\n\tif ( $existing ) {\n\t\treturn (int) $existing->ID;\n\t}\n\t$id = wp_insert_post(\n\t\tarray(\n\t\t\t'post_title'   => $title,\n\t\t\t'post_name'    => $slug,\n\t\t\t'post_content' => $placeholder,\n\t\t\t'post_status'  => 'publish',\n\t\t\t'post_type'    => 'page',\n\t\t\t'post_parent'  => $parent,\n\t\t),\n\t\ttrue\n\t);\n\tif ( is_wp_error( $id ) ) {\n\t\tfwrite( STDERR, $id->get_error_message() . PHP_EOL );\n\t\texit( 1 );\n\t}\n\treturn (int) $id;"
    },
    {
      "rel": "app/public/wp-content/themes/shpigovsky/inc/site-chrome.php",
      "bytes": 5350,
      "sha256": "e5c5ba22af19b91d092acb6c4990a244c0bbdbd5a39d7afda01887720f5295d6",
      "mentions_wp_insert": false,
      "mentions_wp_update": false,
      "mentions_delete": false,
      "requires_wp_load": false,
      "preview_head": "<?php\n/**\n * Site chrome helpers — safe ACF option reads and asset URLs.\n *\n * @package Shpigovsky\n */\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\n/**\n * Read an ACF options field without fatal when ACF or value is missing.\n *\n * @param string $field_name Option field name.\n * @return string Sanitized scalar string or empty.\n */\nfunction shpigovsky_get_site_option( $field_name ) {\n\tif ( ! function_exists( 'get_field' ) ) {\n\t\treturn '';\n\t}\n\n\t$value = get_field( $field_name, 'option' );\n\n\tif ( is_array( $value ) || is_object( $value ) ) {\n\t\treturn '';\n\t}\n\n\treturn is_string( $value ) ? trim( $value ) : ( is_numeric( $value ) ? (string) $value : '' );\n}\n\n/**\n * Theme asset URI helper.\n *\n * @param string $relative_path Path relative to theme assets root.\n * @return string Escaped-ready URI.\n */\nfunction shpigovsky_asset_uri( $relative_path ) {\n\treturn trailingslashit( SHPIGOVSKY_THEME_URI ) . 'assets/' . ltrim( $relative_path, '/' );\n}"
    },
    {
      "rel": "app/public/wp-content/themes/shpigovsky/template-parts/navigation/messenger-links.php",
      "bytes": 1815,
      "sha256": "e281d168717ef037c067d3e20a76298b925ef13aa09c2d05212da60ed600f05c",
      "mentions_wp_insert": false,
      "mentions_wp_update": false,
      "mentions_delete": false,
      "requires_wp_load": false,
      "preview_head": "<?php\n/**\n * Messenger icon links — configured social_links or static V9 visual fallback.\n *\n * D9-B: when social_links is empty, render placeholder href=\"#\" icons for parity.\n *\n * @package Shpigovsky\n *\n * @var array<string, mixed> $args Template args.\n */\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\n$context = isset( $args['context'] ) ? (string) $args['context'] : 'header';\n$rows    = shpigovsky_get_messenger_link_rows( $context );\n\nif ( empty( $rows ) ) {\n\treturn;\n}\n\n$wrapper_class = 'offcanvas' === $context || 'mobile-header' === $context ? 'offcanvas__messengers' : 'site-header__messengers';\n$link_class    = 'offcanvas' === $context || 'mobile-header' === $context ? 'offcanvas__messenger-link' : 'site-header__messenger-link';\n$icon_class    = 'offcanvas' === $context || 'mobile-header' === $context ? 'offcanvas__messenger-icon' : 'site-header__messenger-icon';\n\nif ( 'mobile-header' === $context ) {\n\t$wrapper_class = 'mobile-header__messengers';\n}\n?>\n<div class=\"<?php echo esc_attr( $wrapper_class ); ?>\">\n\t<?php foreach ( $rows as $row ) : ?>\n\t\t<?php\n\t\t$icon = isset( $row['icon'] ) && '' !== $row['icon']\n\t\t\t? (string) $row['icon']\n\t\t\t: shpigovsky_social_icon_for_label( $row['label'] );\n\t\t$label = '' !== $row['label'] ? $row['label'] : __( 'Социальная сеть', 'shpigovsky' );\n\t\t?>\n\t\t<a class=\"<?php echo esc_attr( $link_class ); ?>\" href=\"<?php echo esc_url( $row['url'] ); ?>\" aria-label=\"<?php echo esc_attr( $label ); ?>\">\n\t\t\t<?php if ( '' !== $icon ) : ?>"
    }
