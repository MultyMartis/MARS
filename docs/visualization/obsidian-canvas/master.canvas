      "y": 140,
      "width": 280,
      "height": 100
    },
    {
      "id": "n-layer-core-contract",
      "type": "text",
      "text": "## Core Contract Layer\n\n`control-plane/`, `workflows/`, `interfaces/`, `security/`, `tools/`, `models/`, `storage/`, `memory/`, `observability/`, `evaluation/`, `integrations/`, `mars-runtime/`",
